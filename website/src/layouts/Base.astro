---
import "../styles/global.css";
import { strings, pathFor, type Lang, type Page } from "../i18n";

interface Props {
  page?: Page;
  /** Docs page slug, for the canonical and alternate links. */
  slug?: string;
  /** Title and description of a page whose strings are not in the dictionary (a docs page). */
  meta?: { title: string; description: string };
}
const { page = "home", slug } = Astro.props;
const lang = (Astro.currentLocale ?? "en") as Lang;
const t = strings(lang);
const meta = Astro.props.meta ?? (page === "agents" ? t.agents.meta : page === "docs" ? t.docs.meta : t.meta);
const canonical = new URL(pathFor(lang, page, slug), Astro.site);
// English pages only: a first visit with a Spanish browser goes to the /es/ twin; a choice made with
// the header's language switch (localStorage "lang") wins after that.
const alternates = (["en", "es"] as const).map((l) => ({ lang: l, href: new URL(pathFor(l, page, slug), Astro.site) }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      lang === "en" && (
        <script is:inline>
          try {
            var pick = localStorage.getItem("lang");
            if (pick ? pick === "es" : /^es\b/i.test(navigator.language)) location.replace("/es" + location.pathname + location.hash);
          } catch (e) {}
        </script>
      )
    }
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor("en", page, slug), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#141517" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:image" content={new URL("/apple-touch-icon.png", Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/json" id="i18n" set:html={JSON.stringify(t.runtime)} />
  </head>
  <body>
    <slot />
  </body>
</html>
