---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Showcase from "../components/Showcase.astro";
import Loop from "../components/Loop.astro";
import Features from "../components/Features.astro";
import Workflows from "../components/Workflows.astro";
import GetStarted from "../components/GetStarted.astro";
import OpenSource from "../components/OpenSource.astro";
import Footer from "../components/Footer.astro";
import Ruler from "../components/Ruler.astro";
import { latestVersion } from "../site";

const version = await latestVersion();
---

<Base
  title="Frameshell: an IDE for video"
  description="Edit any video by asking for it: an AI agent cuts pauses, adds subtitles, logos and zooms, turns one recording into shorts and builds explainer animations, while you watch and fix it in the timeline. Open source desktop app for macOS, Windows and Linux."
>
  <Header />
  <main>
    <Hero version={version} />
    <Showcase />
    <Loop />
    <Features />
    <Workflows />
    <GetStarted version={version} />
    <OpenSource />
  </main>
  <Footer />
  <Ruler />
</Base>

<script>
  import "../scripts/page";
</script>
