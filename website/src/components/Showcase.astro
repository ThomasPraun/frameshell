              </div>
            </template>
            <!-- f5: HyperFrames composition (the overlay from part 04) -->
            <template data-if="f5">
              <div style="display: grid; grid-template-rows: auto auto; flex: 1">
                <pre class="code type-in" style="border-bottom: 1px solid #34363a">&lt;<span class="k">div</span> <span class="a">data-composition-id</span>=<span class="s">"sketch"</span>
     <span class="a">data-width</span>=<span class="s">"1920"</span> <span class="a">data-height</span>=<span class="s">"1080"</span>
     <span class="a">data-duration</span>=<span class="s">"9"</span> <span class="a">data-no-timeline</span>&gt;
  &lt;<span class="k">svg</span>&gt;&lt;<span class="k">path</span> <span class="a">class</span>=<span class="s">"chalk"</span> <span class="a">d</span>=<span class="s">"M195 1080 L667 757 L1282 757 …"</span>/&gt;&lt;/<span class="k">svg</span>&gt;
  &lt;<span class="k">h1</span> <span class="a">class</span>=<span class="s">"title"</span>&gt;TIMELINE &lt;<span class="k">em</span>&gt;TALKS&lt;/<span class="k">em</span>&gt;&lt;/<span class="k">h1</span>&gt;
  &lt;<span class="k">span</span> <span class="a">class</span>=<span class="s">"badge"</span>&gt;{t.episode}&lt;/<span class="k">span</span>&gt;
  &lt;<span class="k">div</span> <span class="a">class</span>=<span class="s">"equalizer"</span>&gt;…&lt;/<span class="k">div</span>&gt;
  &lt;<span class="k">p</span> <span class="a">class</span>=<span class="s">"note"</span>&gt;{t.host}&lt;/<span class="k">p</span>&gt; &lt;<span class="k">p</span> <span class="a">class</span>=<span class="s">"note"</span>&gt;{t.guest}&lt;/<span class="k">p</span>&gt;
&lt;/<span class="k">div</span>&gt;</pre>
                <div style="position: relative; margin: 18px 20px 20px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 6px; background: #0b0b0c; container-type: inline-size">
