                  <span style="color: #6fae8b">{t.rows.voice}</span>
                  <div style="display: flex; height: 22px"><span class="grow" style="--d: .8s; flex: 0 0 100%; border-radius: 3px; background: repeating-linear-gradient(90deg, rgba(143,209,171,0.55) 0 3px, transparent 3px 6px) center / 100% 70% no-repeat, #2f4a3c"></span></div>
                </div>
                <p style="margin: 14px 0 0; color: #a3a49f; font-size: 14px" set:html={p.mainNote} />
              </div>
            </template>
            <!-- f4: the short -->
            <template data-if="f4">
              <div class="slide-up" style="padding: 24px; display: flex; gap: 24px; align-items: center; justify-content: center; flex-wrap: wrap">
                <div style="position: relative; width: 210px; aspect-ratio: 9 / 16; overflow: hidden; border-radius: 14px; box-shadow: 0 0 0 2px #e3a53c, 0 24px 60px rgba(0,0,0,0.6); container-type: inline-size">
