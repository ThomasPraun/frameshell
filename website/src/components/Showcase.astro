              <template data-if="shortOn">
                <span class="beat" data-style="shortStyle"></span>
              </template>
              <span class="playhead" data-style="playheadStyle"></span>
            </div>
          </div>
          </template>
        </div>

        <div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px">
          <p style="margin: 0; color: #e4e3dc; font-size: 16px; font-weight: 600">{t.everyStep}</p>
          <p style="margin: 0; color: #8a8b8f; font-size: 13px">{t.aiFootage}</p>
        </div>
      </section>
    </div>
</div>

<div class="sc" data-showcase-project>
  <!-- One recording branches into a whole project folder -->
  <section id="project" data-marker={p.marker} style="padding: clamp(96px, 14vw, 180px) 0 clamp(48px, 8vw, 96px)">
    <div style="max-width: 1240px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px)">
      <h2 class="display" style="max-width: 15ch; font-size: clamp(2.3rem, 6vw, 5rem)">{p.title}</h2>
      <p style="margin: 28px 0 0; max-width: 62ch; color: #a3a49f; font-size: 18px; line-height: 1.6">{p.lede}</p>

      <div data-ref="tree" class="gen-grid" style="display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr); gap: 0; margin-top: clamp(40px, 6vw, 72px); border: 1px solid #34363a; border-radius: 14px; overflow: hidden; background: #1d1e20">

        <!-- File tree -->
        <div style="display: flex; flex-direction: column; min-width: 0; padding: 18px 10px 18px 18px; background: #18191b; border-right: 1px solid #34363a">
          <span style="padding: 0 8px 12px; color: #8a8b8f; font-size: 13px">{t.explorer}</span>
          <template data-if="treeSeen">
            <ul class="mono" style="margin: 0; padding: 0; list-style: none; font-size: 13px; line-height: 1.2" data-list="tree"></ul>
          </template>
        </div>

        <!-- What the selected file is -->
        <div style="display: flex; flex-direction: column; min-width: 0">
          <div style="display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 20px; border-bottom: 1px solid #34363a">
            <span class="mono" style="flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #e4e3dc; font-size: 13px"><span data-text="filePath"></span></span>
            <template data-if="fileLive">
              <span style="display: flex; align-items: center; gap: 6px; padding: 3px 9px; border-radius: 99px; background: rgba(224,103,95,0.14); color: #f0a49e; font-size: 12px; font-weight: 600"><span class="live-dot"></span>{p.live}</span>
            </template>
          </div>

          <div style="flex: 1; min-height: 420px; position: relative; display: flex; flex-direction: column">
            <!-- f0: the recording -->
            <template data-if="f0">
              <div class="slide-up" style="padding: 24px; display: flex; flex-direction: column; gap: 14px">
                <img src="/media/podcast-poster.jpg" alt={p.wideAlt} style="width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 6px">
                <div class="mono" style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 12px; color: #a3a49f">
                  <span style="padding: 4px 9px; border-radius: 4px; background: #26272a">1920 × 1080</span>
                  <span style="padding: 4px 9px; border-radius: 4px; background: #26272a">9.4 s</span>
                  <span style="padding: 4px 9px; border-radius: 4px; background: #26272a">24 fps</span>
                  <span style="padding: 4px 9px; border-radius: 4px; background: #26272a">{p.voice}</span>
                </div>
              </div>
            </template>
            <!-- f1: transcript -->
            <template data-if="f1">
              <pre class="code type-in" style="flex: 1">[
  <span class="c">{p.txComment}</span>
  &#123; <span class="a">"text"</span>: <span class="s">"What"</span>,      <span class="a">"start"</span>: <span class="n">0.18</span>, <span class="a">"end"</span>: <span class="n">0.20</span> &#125;,
  &#123; <span class="a">"text"</span>: <span class="s">"can't"</span>,     <span class="a">"start"</span>: <span class="n">0.20</span>, <span class="a">"end"</span>: <span class="n">0.47</span> &#125;,
  &#123; <span class="a">"text"</span>: <span class="s">"you"</span>,       <span class="a">"start"</span>: <span class="n">0.47</span>, <span class="a">"end"</span>: <span class="n">0.64</span> &#125;,
  &#123; <span class="a">"text"</span>: <span class="s">"edit"</span>,      <span class="a">"start"</span>: <span class="n">0.64</span>, <span class="a">"end"</span>: <span class="n">0.81</span> &#125;,
  &#123; <span class="a">"text"</span>: <span class="s">"without?"</span>,  <span class="a">"start"</span>: <span class="n">0.81</span>, <span class="a">"end"</span>: <span class="n">1.36</span> &#125;,
  <span class="c">{p.txGap}</span>
  &#123; <span class="a">"text"</span>: <span class="s">"A"</span>,         <span class="a">"start"</span>: <span class="n">3.18</span>, <span class="a">"end"</span>: <span class="n">3.36</span> &#125;,
  &#123; <span class="a">"text"</span>: <span class="s">"good"</span>,      <span class="a">"start"</span>: <span class="n">3.36</span>, <span class="a">"end"</span>: <span class="n">3.90</span> &#125;,
  &#123; <span class="a">"text"</span>: <span class="s">"timeline."</span>, <span class="a">"start"</span>: <span class="n">3.90</span>, <span class="a">"end"</span>: <span class="n">4.44</span> &#125;,
  <span class="c">// …</span>
]</pre>
            </template>
