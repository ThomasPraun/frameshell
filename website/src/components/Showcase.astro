<span class="k" style="font-weight: 700">{p.script.question}</span>
{p.script.questionBody}

<span class="k" style="font-weight: 700">{p.script.answer}</span>
"If your timeline's a mess, your video's a mess."
{p.script.close} <span class="n">{p.script.isShort}</span>

<span class="k" style="font-weight: 700">{p.script.sponsor}</span>
{p.script.sponsorBody}

<span class="c">{p.script.note}</span></pre>
