---
// Hero carousel (one real clip, a layer per part) and the project tree it leads into.
// Markup ported from the design canvas; src/scripts/showcase.ts drives every data-* hook.
import "../styles/showcase.css";
import { strings } from "../i18n";

const t = strings(Astro.currentLocale).showcase;
const p = t.project;
// Fallback picture per director angle (wide, him, her) until the clip's frames paint the tile;
// same crops as ANGLES in src/scripts/showcase.ts.
const anglePic = [
  "background-size: 100%; background-position: 50% 50%",
  "background-size: 170%; background-position: 88% 36%",
  "background-size: 160%; background-position: 6% 36%",
];
---

<div class="sc" data-showcase>
    <!-- Use-case carousel: one podcast clip, a new layer per slide -->
    <div class="rise" style="max-width: 1240px; margin: clamp(40px, 7vw, 80px) auto 0; padding: 0 clamp(16px, 4vw, 48px)">
      <section aria-roledescription="carousel" aria-label={t.carousel} style="display: flex; flex-direction: column; gap: 18px">

        <div class="tabs" role="tablist" aria-label={t.tabs} style="display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 12px">
          <div data-list="slides" style="display: contents"></div>
        </div>

        <div style="border: 1px solid #34363a; border-radius: 14px; overflow: hidden; background: #1d1e20; box-shadow: 0 40px 120px -40px rgba(0,0,0,0.8)">
          <div class="stage-grid" style="display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr)">

            <!-- Preview -->
            <div style="padding: 20px; background: #161719; min-width: 0">
              <div data-class="frameCls" style="position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 6px; background: #0b0b0c; container-type: inline-size">
                <template data-if="isVertical">
                  <img src="/media/podcast-poster.jpg" alt="" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.22; filter: grayscale(1)">
                  <span class="beat mono" style="--d: .2s; position: absolute; left: 3%; top: 5%; padding: 0.5cqw 1cqw; border-radius: 0.6cqw; background: rgba(15,15,18,0.7); color: #a3a49f; font-size: 1.5cqw">{t.original}</span>
                  <span class="beat mono" style="--d: .4s; position: absolute; right: 3%; top: 5%; padding: 0.5cqw 1cqw; border-radius: 0.6cqw; background: rgba(227,165,60,0.18); color: #e3a53c; font-size: 1.5cqw">{t.short}</span>
                </template>

                <div data-style="viewStyle">
                  <video data-ref="video" src="/media/podcast.mp4" poster="/media/podcast-poster.jpg" muted="" playsinline="" preload="auto" data-style="videoStyle"></video>

                  <!-- From audio: only the clip's voice. An animation built from the transcript follows the dialogue
                       (classes b1..b7 from showcase.ts, one per beat, cumulative). -->
                  <template data-if="audioOn">
                    <div data-class="audCls" style="position: absolute; inset: 0; background: radial-gradient(ellipse 62% 58% at 50% 46%, #25272e 0%, #17181b 72%)">
                      <svg viewBox="0 0 1920 1080" aria-hidden="true" style="position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible">
                        <defs><linearGradient id="fs-accent-a" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffb347"></stop><stop offset="0.55" stop-color="#ff6a3d"></stop><stop offset="1" stop-color="#e8336f"></stop></linearGradient></defs>
                        <!-- "What can't you edit without?" -->
                        <g class="a-qs">
                          <g class="a-bob" style="--i: 0"><text class="a-q" x="690" y="590" font-size="300" style="--i: 0">?</text></g>
                          <g class="a-bob" style="--i: 1"><text class="a-q hot" x="890" y="540" font-size="440" style="--i: 1">?</text></g>
                          <g class="a-bob" style="--i: 2"><text class="a-q" x="1170" y="620" font-size="240" style="--i: 2">?</text></g>
                        </g>
                        <!-- "A good timeline." -->
                        <g class="a-track">
                          <path d="M360 720 H1560" stroke="#34363a" stroke-width="8" stroke-linecap="round"></path>
                          <rect class="a-clip" x="360" y="692" width="360" height="56" rx="10" fill="#3f5373" style="--i: 0"></rect>
                          <rect class="a-clip" x="732" y="692" width="420" height="56" rx="10" fill="#2f4a3c" style="--i: 1"></rect>
                          <rect class="a-clip" x="1164" y="692" width="396" height="56" rx="10" fill="#4a3a55" style="--i: 2"></rect>
                          <rect class="a-ph" x="-4" y="656" width="8" height="128" rx="4" fill="#e3a53c"></rect>
                        </g>
                        <!-- "If your timeline's a mess, your video's a mess." -->
                        <g class="a-tangle">
                          <path class="a-knot" pathLength="1" d="M360 720 L720 720 C800 720 820 600 900 600 C990 600 1000 760 920 770 C840 780 850 620 960 610 C1080 600 1100 760 1010 770 C930 780 940 640 1030 640 C1110 640 1120 720 1200 720 L1560 720" stroke="#e4e3dc" stroke-width="10"></path>
                          <path class="a-mess" pathLength="1" d="M760 640 C820 540 940 820 1000 660 C1050 530 1160 800 1080 760 C1000 720 1120 600 1180 650" stroke="#e0675f" stroke-width="7"></path>
                          <path class="a-mess two" pathLength="1" d="M820 800 C900 700 860 560 960 560 C1080 560 1020 820 900 720 C840 670 1000 640 1120 780" stroke="#e0675f" stroke-width="6"></path>
                        </g>
                        <g class="a-play">
                          <circle cx="960" cy="430" r="120" fill="#e3a53c"></circle>
                          <path d="M922 366 L1018 430 L922 494 Z" fill="#1a1408" stroke="#1a1408" stroke-width="10" stroke-linejoin="round"></path>
                        </g>
                        <g class="a-face">
                          <circle cx="960" cy="290" r="118" fill="#26272a" stroke="#e4e3dc" stroke-width="9"></circle>
                          <path d="M886 262 L942 240 M1034 262 L978 240" stroke="#e4e3dc" stroke-width="9" stroke-linecap="round" fill="none"></path>
                          <circle cx="918" cy="292" r="13" fill="#e4e3dc"></circle>
                          <circle cx="1002" cy="292" r="13" fill="#e4e3dc"></circle>
                          <path d="M902 360 Q926 338 950 360 T998 360 T1022 352" stroke="#e4e3dc" stroke-width="9" stroke-linecap="round" fill="none"></path>
                          <path class="a-drop" d="M1086 214 C1100 238 1108 252 1108 264 A22 22 0 0 1 1064 264 C1064 252 1072 238 1086 214 Z" fill="#66c2e0"></path>
                        </g>
                        <!-- "Brought to you by our sponsor." -->
                        <g class="a-fix">
                          <svg x="840" y="300" width="240" height="217" viewBox="200 230 624 564">
                            <g fill="none" stroke="#ffffff" stroke-width="40" stroke-linecap="round" stroke-linejoin="round"><path d="M232 352 V262 H322"></path><path d="M702 262 H792 V352"></path><path d="M792 672 V762 H702"></path><path d="M322 762 H232 V672"></path></g>
                            <path d="M372 392 L532 512 L372 632" fill="none" stroke="url(#fs-accent-a)" stroke-width="68" stroke-linecap="round" stroke-linejoin="round"></path>
                            <rect x="560" y="600" width="130" height="58" rx="29" fill="url(#fs-accent-a)"></rect>
                          </svg>
                          <text x="960" y="640" text-anchor="middle" font-size="96" class="a-word">frameshell</text>
                          <path class="a-line" pathLength="1" d="M360 760 H1560" stroke="#34363a" stroke-width="8" stroke-linecap="round"></path>
                          <rect class="a-clip" x="360" y="732" width="360" height="56" rx="10" fill="#3f5373" style="--i: 3"></rect>
                          <rect class="a-clip" x="732" y="732" width="420" height="56" rx="10" fill="#2f4a3c" style="--i: 4"></rect>
                          <rect class="a-clip" x="1164" y="732" width="396" height="56" rx="10" fill="#4a3a55" style="--i: 5"></rect>
                        </g>
                      </svg>
                    </div>
                    <span class="beat mono" style="--d: .2s; position: absolute; left: 2.5%; top: 4%; display: flex; align-items: center; gap: 0.8cqw; padding: 0.5cqw 1cqw; border-radius: 0.6cqw; background: rgba(15,15,18,0.6); color: #8fd1ab; font-size: max(1.5cqw, 9px)">
                      <svg viewBox="0 0 40 24" aria-hidden="true" style="width: 2.4cqw; height: 1.5cqw"><g fill="#6fae8b"><rect class="bar" x="0" y="6" width="5" height="12" rx="2.5" style="--d: 0s"></rect><rect class="bar" x="9" y="0" width="5" height="24" rx="2.5" style="--d: .2s"></rect><rect class="bar" x="18" y="4" width="5" height="16" rx="2.5" style="--d: .1s"></rect><rect class="bar" x="27" y="1" width="5" height="22" rx="2.5" style="--d: .3s"></rect><rect class="bar" x="35" y="7" width="5" height="10" rx="2.5" style="--d: .15s"></rect></g></svg>
                      podcast-ep12.m4a <span style="color: #a3a49f">{t.audioOnly}</span>
                    </span>
                  </template>

                  <!-- Logo and drawing: chalk table, pointers and the show's title on the empty wall, live over the
                       footage; it clears away before the sponsor line, and the sponsor takes the center. -->
                  <template data-if="drawOn">
                    <div data-class="chalkCls">
                      <svg class="c-art" viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice" aria-hidden="true" style="position: absolute; inset: 0; width: 100%; height: 100%">
                        <path class="draw" pathLength="1" style="--d: .2s" d="M195 1080 L667 757 L1282 757 L1755 1080" stroke="#e3a53c" stroke-width="7"></path>
                        <path class="draw" pathLength="1" style="--d: .6s" d="M960 757 L960 1080" stroke="#e3a53c" stroke-width="5"></path>
                        <g fill="#e3a53c">
                          <rect class="bar" x="824" y="430" width="20" height="130" rx="10" style="--d: 0s"></rect>
                          <rect class="bar" x="858" y="400" width="20" height="190" rx="10" style="--d: .15s"></rect>
                          <rect class="bar" x="892" y="375" width="20" height="240" rx="10" style="--d: .3s"></rect>
                          <rect class="bar" x="926" y="410" width="20" height="170" rx="10" style="--d: .05s"></rect>
                          <rect class="bar" x="960" y="365" width="20" height="260" rx="10" style="--d: .25s"></rect>
                          <rect class="bar" x="994" y="405" width="20" height="180" rx="10" style="--d: .4s"></rect>
                          <rect class="bar" x="1028" y="385" width="20" height="220" rx="10" style="--d: .1s"></rect>
                          <rect class="bar" x="1062" y="420" width="20" height="150" rx="10" style="--d: .35s"></rect>
                          <rect class="bar" x="1096" y="445" width="20" height="100" rx="10" style="--d: .2s"></rect>
                        </g>
                        <path class="draw" pathLength="1" style="--d: 2.2s" d="M1150 690 C1250 650 1330 600 1395 505 M1365 513 L1397 501 L1403 535" stroke="#fff3df" stroke-width="5"></path>
                        <path class="draw" pathLength="1" style="--d: 2.4s" d="M770 690 C670 650 590 600 525 505 M555 513 L523 501 L517 535" stroke="#fff3df" stroke-width="5"></path>
                      </svg>
                      <div class="c-title" style="position: absolute; left: 0; right: 0; top: 11%; display: flex; flex-direction: column; align-items: center; gap: 1cqw">
                        <p style="margin: 0; font-size: 4.6cqw; font-weight: 900; font-stretch: 125%; letter-spacing: -0.03em; line-height: 1; color: #fff3df; text-shadow: 0 0.35cqw 0 #8d5f33, 0 0 2cqw rgba(0,0,0,0.5)">
                          <span class="letter" style="--d: .8s">T</span><span class="letter" style="--d: .86s">I</span><span class="letter" style="--d: .92s">M</span><span class="letter" style="--d: .98s">E</span><span class="letter" style="--d: 1.04s">L</span><span class="letter" style="--d: 1.1s">I</span><span class="letter" style="--d: 1.16s">N</span><span class="letter" style="--d: 1.22s">E</span>
                          <span class="letter" style="--d: 1.4s; color: #e3a53c">T</span><span class="letter" style="--d: 1.46s; color: #e3a53c">A</span><span class="letter" style="--d: 1.52s; color: #e3a53c">L</span><span class="letter" style="--d: 1.58s; color: #e3a53c">K</span><span class="letter" style="--d: 1.64s; color: #e3a53c">S</span>
                        </p>
                        <span class="slide-up mono" style="--d: 1.9s; padding: 0.4cqw 1.2cqw; border-radius: 99px; background: #e3a53c; color: #1a1408; font-size: 1.4cqw; font-weight: 700">{t.episode}</span>
                      </div>
                      <div class="c-labels" style="position: absolute; inset: 0">
                        <p class="hand write" style="--d: 2.6s; position: absolute; left: 36%; top: 62%; margin: 0; font-size: 3cqw; color: #fff3df">{t.host}</p>
                        <p class="hand write" style="--d: 2.8s; position: absolute; left: 54%; top: 62%; margin: 0; font-size: 3cqw; color: #fff3df">{t.guest}</p>
                      </div>
                    </div>
                    <div data-class="sponsorCls">
                      <div class="sp-card">
                        <span class="sp-by">{t.sponsoredBy}</span>
                        <span class="sp-logo">
                          <svg viewBox="200 230 624 564" aria-hidden="true" style="width: 7.6cqw; height: 7.6cqw">
                            <defs><linearGradient id="fs-accent" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffb347"></stop><stop offset="0.55" stop-color="#ff6a3d"></stop><stop offset="1" stop-color="#e8336f"></stop></linearGradient></defs>
                            <g fill="none" stroke="#ffffff" stroke-width="40" stroke-linecap="round" stroke-linejoin="round"><path d="M232 352 V262 H322"></path><path d="M702 262 H792 V352"></path><path d="M792 672 V762 H702"></path><path d="M322 762 H232 V672"></path></g>
                            <path d="M372 392 L532 512 L372 632" fill="none" stroke="url(#fs-accent)" stroke-width="68" stroke-linecap="round" stroke-linejoin="round"></path>
                            <rect x="560" y="600" width="130" height="58" rx="29" fill="url(#fs-accent)"></rect>
                          </svg>
                          <strong>frameshell</strong>
                        </span>
                        <span class="sp-bar"></span>
                      </div>
                    </div>
                  </template>

                  <template data-if="showCaption">
                    <p class="cap" data-style="captionStyle"><span data-text="caption"></span></p>
                  </template>
                </div>

                <!-- Director: the group's angles (crops of the clip), the shot on air outlined, who speaks marked -->
                <template data-if="anglesOn">
                  <div class="beat" aria-hidden="true" style="position: absolute; left: 2.5%; top: 4%; z-index: 4; display: grid; grid-template-columns: repeat(3, max(13cqw, 64px)); gap: max(0.8cqw, 4px); padding: max(0.8cqw, 4px); border-radius: 1cqw; background: rgba(15,15,18,0.62); backdrop-filter: blur(6px)">
                    {
                      t.angles.map((name, i) => (
                        <div data-style={`angle${i}`}>
                          <span style={`position: absolute; inset: 0; background: url(/media/podcast-poster.jpg) no-repeat; ${anglePic[i]}`} />
                          <canvas data-angle={i} width="208" height="117" style="position: absolute; inset: 0; width: 100%; height: 100%" />
                          <span class="mono" style="position: absolute; left: 0.5cqw; bottom: 0.5cqw; padding: 0 0.5cqw; border-radius: 0.3cqw; background: rgba(15,15,18,0.75); color: #e4e3dc; font-size: max(1.1cqw, 9px); line-height: 1.6">{i + 1}</span>
                          <span style="position: absolute; right: 0.5cqw; bottom: 0.5cqw; padding: 0 0.5cqw; border-radius: 0.3cqw; background: rgba(15,15,18,0.75); color: #e4e3dc; font-size: max(1.1cqw, 9px); line-height: 1.6">{name}</span>
                          <template data-if={`speak${i}`}>
                            <span style="position: absolute; right: 0.5cqw; top: 0.5cqw; display: flex; align-items: center; gap: 0.4cqw; padding: 0 0.5cqw; border-radius: 0.3cqw; background: rgba(15,15,18,0.75); color: #8fd1ab; font-size: max(1cqw, 8px); line-height: 1.6">
                              <svg viewBox="0 0 22 24" style="width: 1cqw; height: 1.1cqw"><g fill="#6fae8b"><rect class="bar" x="0" y="4" width="5" height="16" rx="2.5" style="--d: 0s"></rect><rect class="bar" x="8.5" y="0" width="5" height="24" rx="2.5" style="--d: .2s"></rect><rect class="bar" x="17" y="5" width="5" height="14" rx="2.5" style="--d: .1s"></rect></g></svg>
                              {t.speaking}
                            </span>
                          </template>
                        </div>
                      ))
                    }
                  </div>
                </template>

                <!-- Into the project: a mouse pulls the clip out of full screen into the app, drops it into its folder and opens it -->
                <template data-if="tourOn">
                  <div class="app7" style="position: absolute; inset: 0; z-index: 2; background: #1d1e20; font-size: 1.3cqw; color: #e4e3dc">
                    <div style="position: absolute; left: 0; right: 0; top: 0; height: 5%; display: flex; align-items: center; gap: 0.6cqw; padding: 0 1.2cqw; background: #19191b; border-bottom: 1px solid #34363a">
                      <span style="width: 0.9cqw; height: 0.9cqw; border-radius: 50%; background: #303135"></span><span style="width: 0.9cqw; height: 0.9cqw; border-radius: 50%; background: #303135"></span><span style="width: 0.9cqw; height: 0.9cqw; border-radius: 50%; background: #303135"></span>
                      <span style="flex: 1; text-align: center; color: #8a8b8f; font-size: 1.1cqw">frameshell</span>
                    </div>
                    <div style="position: absolute; left: 0; top: 5%; bottom: 0; width: 22%; background: #18191b; border-right: 1px solid #34363a">
                      <span style="position: absolute; left: 1.2cqw; top: 2.5%; color: #8a8b8f; font-size: 1.1cqw">{t.explorer}</span>
                    </div>
                    <div style="position: absolute; left: 25%; top: 9%; width: 70%; height: 70%; border-radius: 0.6cqw; background: #0b0b0c; box-shadow: inset 0 0 0 1px #34363a"></div>
                    <div style="position: absolute; left: 25%; right: 5%; top: 82%; display: flex; flex-direction: column; gap: 0.5cqw">
                      <span style="height: 1.6cqw; width: 78%; border-radius: 0.3cqw; background: #4a3a55"></span>
                      <span style="height: 1.6cqw; width: 78%; border-radius: 0.3cqw; background: #3f5373"></span>
                      <span style="height: 1.6cqw; width: 78%; border-radius: 0.3cqw; background: #2f4a3c"></span>
                    </div>

                    <!-- the folder the clip goes into -->
                    <div class="folder7" style="position: absolute; left: 1.4%; top: 13%; width: 19%; height: 11%; display: flex; align-items: center; gap: 0.8cqw; padding: 0 0.8cqw; border-radius: 0.6cqw">
                      <svg class="folder7-icon" viewBox="0 0 64 52" aria-hidden="true" style="flex: none; width: 4.2cqw; height: 3.4cqw"><path d="M2 8a6 6 0 0 1 6-6h16l6 7h26a6 6 0 0 1 6 6v29a6 6 0 0 1-6 6H8a6 6 0 0 1-6-6z" fill="#e3a53c"></path><path d="M2 18h60v26a6 6 0 0 1-6 6H8a6 6 0 0 1-6-6z" fill="#f0b75a"></path></svg>
                      <span style="font-weight: 700">podcast-ep12</span>
                      <span class="badge7" style="margin-left: auto; min-width: 1.8cqw; height: 1.8cqw; border-radius: 99px; background: #e0675f; color: #ffffff; font-size: 1.1cqw; font-weight: 700; display: grid; place-items: center">1</span>
                    </div>

                    <!-- the tree, unfolding after the click -->
                    <div class="mono" style="position: absolute; left: 1.2cqw; right: 1cqw; top: 26%; display: flex; flex-direction: column; font-size: 1.15cqw">
                      <span class="row7" style="--d: 5.6s">▾ assets/</span>
                      <span class="row7 sub pick-mp4" style="--d: 5.7s"><img src="/media/podcast-poster.jpg" alt="" style="height: 1.6cqw; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 0.2cqw">podcast-ep12.mp4</span>
                      <span class="row7" style="--d: 5.8s">▸ transcripts/</span>
                      <span class="row7" style="--d: 5.9s">▸ scripts/</span>
                      <span class="row7" style="--d: 6s">▾ timelines/</span>
                      <span class="row7 sub" style="--d: 6.1s">main.json</span>
                      <span class="row7 sub pick-a" style="--d: 6.2s">short-guest.json</span>
                      <span class="row7" style="--d: 6.3s">▾ compositions/</span>
                      <span class="row7 sub" style="--d: 6.4s">sketch/index.html</span>
                      <span class="row7 sub" style="--d: 6.5s; color: #66c2e0">Explainer.tsx</span>
                      <span class="row7" style="--d: 6.6s">▾ exports/</span>
                      <span class="row7 sub" style="--d: 6.7s; color: #66c2e0">explainer.mp4</span>
                    </div>

                    <!-- what the clicks open in the preview -->
                    <div class="show-a" style="position: absolute; left: 25%; top: 9%; width: 70%; height: 70%; display: flex; align-items: center; justify-content: center; border-radius: 0.6cqw; overflow: hidden; background: #0b0b0c">
                      <div style="position: relative; height: 92%; aspect-ratio: 9 / 16; overflow: hidden; border-radius: 0.8cqw; box-shadow: 0 0 0 0.2cqw #e3a53c">
                        <img src="/media/podcast-poster.jpg" alt="" style="width: 100%; height: 100%; object-fit: cover; object-position: 84% 50%">
                        <p style="position: absolute; left: 5%; right: 5%; bottom: 18%; margin: 0; text-align: center; font-size: 2.2cqw; font-weight: 900; font-stretch: 112%; line-height: 1.05; text-transform: uppercase; color: #ffffff; text-shadow: 0 0.3cqw 1cqw rgba(0,0,0,0.8)">Your video's <span style="color: #e3a53c">a mess.</span></p>
                      </div>
                    </div>
                  </div>

                  <!-- the mouse -->
                  <span class="cursor7" aria-hidden="true" style="position: absolute; z-index: 7; width: 2.2cqw; height: 2.8cqw; pointer-events: none">
                    <span class="press7" style="position: absolute; left: -1.2cqw; top: -1.2cqw; width: 2.4cqw; height: 2.4cqw; border-radius: 50%; background: rgba(227,165,60,0.55)"></span>
                    <svg viewBox="0 0 16 20" style="position: absolute; inset: 0; width: 100%; height: 100%"><path d="M1 1v15l4-4 3 7 3-1.4-3-6.6h6z" fill="#ffffff" stroke="#000000" stroke-width="1"></path></svg>
                  </span>
                </template>

                <!-- Step title before each part -->
                <div class="intro-veil" data-style="veilStyle">
                  <template data-if="intro">
                    <span class="mono beat" style="font-size: 1.8cqw; color: #e3a53c"><span data-text="introNum"></span></span>
                    <p class="intro-title"><span class="trim"><span><span data-text="introTitle"></span></span></span></p>
                  </template>
                </div>

                <template data-if="tourBadge">
