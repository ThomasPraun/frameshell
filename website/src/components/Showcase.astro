              <p style="margin: 0; min-height: 3em; padding: 12px 14px; border-radius: 12px 12px 12px 3px; background: #2b2c30; font-size: 16px; line-height: 1.45"><span data-text="askTyped"></span><template data-if="typing"><span class="caret7"></span></template></p>
              <template data-if="s0">
                <template data-if="replyOn">
                  <div class="beat" style="--d: .15s; display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; border-radius: 12px 12px 3px 12px; background: rgba(102,194,224,0.1); box-shadow: inset 0 0 0 1px rgba(102,194,224,0.25)">
                  <span style="color: #66c2e0; font-size: 13px; font-weight: 600">{t.agent}</span>
                  <span style="font-size: 15px; line-height: 1.5">{t.replies[0]}</span>
                </div>
                </template>
              </template>
              <template data-if="s1">
                <template data-if="replyOn">
                  <div class="beat" style="--d: .15s; display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; border-radius: 12px 12px 3px 12px; background: rgba(102,194,224,0.1); box-shadow: inset 0 0 0 1px rgba(102,194,224,0.25)">
                  <span style="color: #66c2e0; font-size: 13px; font-weight: 600">{t.agent}</span>
                  <span style="font-size: 15px; line-height: 1.5">{t.replies[1]}</span>
                </div>
                </template>
              </template>
              <template data-if="s2">
                <template data-if="replyOn">
                  <div class="beat" style="--d: .15s; display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; border-radius: 12px 12px 3px 12px; background: rgba(102,194,224,0.1); box-shadow: inset 0 0 0 1px rgba(102,194,224,0.25)">
                  <span style="color: #66c2e0; font-size: 13px; font-weight: 600">{t.agent}</span>
                  <span style="font-size: 15px; line-height: 1.5">{t.replies[2]}</span>
                </div>
                </template>
              </template>
              <template data-if="s3">
                <template data-if="replyOn">
                  <div class="beat" style="--d: .15s; display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; border-radius: 12px 12px 3px 12px; background: rgba(102,194,224,0.1); box-shadow: inset 0 0 0 1px rgba(102,194,224,0.25)">
                  <span style="color: #66c2e0; font-size: 13px; font-weight: 600">{t.agent}</span>
                  <span style="font-size: 15px; line-height: 1.5">{t.replies[3]}</span>
                </div>
                </template>
              </template>
              <template data-if="s4">
                <template data-if="replyOn">
                  <div class="beat" style="--d: .15s; display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; border-radius: 12px 12px 3px 12px; background: rgba(102,194,224,0.1); box-shadow: inset 0 0 0 1px rgba(102,194,224,0.25)">
                  <span style="color: #66c2e0; font-size: 13px; font-weight: 600">{t.agent}</span>
                  <span style="font-size: 15px; line-height: 1.5">{t.replies[4]}</span>
                </div>
                </template>
              </template>
              <template data-if="s5">
                <template data-if="replyOn">
                  <div class="beat" style="--d: .15s; display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; border-radius: 12px 12px 3px 12px; background: rgba(102,194,224,0.1); box-shadow: inset 0 0 0 1px rgba(102,194,224,0.25)">
                  <span style="color: #66c2e0; font-size: 13px; font-weight: 600">{t.agent}</span>
                  <span style="font-size: 15px; line-height: 1.5">{t.replies[5]}</span>
                </div>
