                      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10M11 3v10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg>
                    </template>
                    <template data-if="paused">
                      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3l8 5-8 5z" fill="currentColor"></path></svg>
                    </template>
                  </button>
                  <template data-if="soundAvail">
                    <button type="button" class="ctl" data-on="toggleSound" data-aria="soundLabel">
                      <template data-if="soundOn">
                        <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 8v4h3l4 3V5L6 8z" fill="currentColor"></path><path d="M13 7.5a3.5 3.5 0 0 1 0 5M15 5a7 7 0 0 1 0 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
                      </template>
                      <template data-if="soundOff">
                        <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 8v4h3l4 3V5L6 8z" fill="currentColor"></path><path d="M13 8l4 4m0-4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
                      </template>
                    </button>
                  </template>
                </div>
                </template>

                <!-- Until the first click: the clip waits, so it can start with sound. -->
                <template data-if="waiting">
                  <button type="button" class="big-play" data-on="togglePlay">
                    <span class="big-play-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3l8 5-8 5z" fill="currentColor"></path></svg></span>
                    <span class="big-play-label">{t.watch}</span>
                  </button>
                </template>
              </div>
            </div>

            <!-- Ask panel -->
            <div class="ask-pane" style="display: flex; flex-direction: column; gap: 14px; min-width: 0; padding: 22px; border-left: 1px solid #34363a">
