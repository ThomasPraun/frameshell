                  <div class="beat" style="--d: .15s; display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; border-radius: 12px 12px 3px 12px; background: rgba(102,194,224,0.1); box-shadow: inset 0 0 0 1px rgba(102,194,224,0.25)">
                  <span style="color: #66c2e0; font-size: 13px; font-weight: 600">{t.agent}</span>
                  <span style="font-size: 15px; line-height: 1.5">{t.replies[6]}</span>
                </div>
                </template>
                <template data-if="replyOn"><a class="beat" href="#project" style="--d: .9s; color: #e3a53c; font-size: 15px; font-weight: 600; text-underline-offset: 4px">{t.seeProject}</a></template>
              </template>
              <template data-if="replyOn"><div class="beat" style="--d: .6s; margin-top: auto; display: flex; flex-wrap: wrap; gap: 8px">
                <span style="padding: 6px 10px; border-radius: 4px; background: #26272a; color: #a3a49f; font-size: 13px">{t.undo}</span>
                <span style="padding: 6px 10px; border-radius: 4px; background: #26272a; color: #a3a49f; font-size: 13px">{t.byHand}</span>
              </div></template>
            </div>
          </div>

          <!-- Timeline, in source seconds (0 to 9.4 s); cut parts close up to the left -->
          <template data-if="showTimeline">
          <div style="border-top: 1px solid #34363a; padding: 14px 20px 18px; display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 6px 12px; font-size: 12px; color: rgba(255,255,255,0.9)">
            <template data-if="rowSubs">
            <span style="color: #b48acb; font-weight: 600; line-height: 26px">{t.rows.subtitles}</span>
            <div style="position: relative; height: 26px">
              <div data-list="cues" style="display: contents"></div>
            </div>

            </template>

            <template data-if="hasLogo">
