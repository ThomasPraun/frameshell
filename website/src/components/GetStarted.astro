---
import { RELEASES, assetUrl } from "../site";
import { strings, pathFor, type Lang } from "../i18n";

interface Props {
  version: string;
}
const { version } = Astro.props;
const all = strings(Astro.currentLocale);
const t = all.start;
const d = t.download;
const copy = all.runtime.copy;

const downloads = [
  { os: "macOS", items: [[d.appleSilicon, "macArm"], [d.intel, "macIntel"]], note: d.macNote },
  { os: "Windows", items: [[d.windowsInstaller, "windows"]], note: d.windowsNote },
  { os: "Linux", items: [[".deb", "deb"], ["AppImage", "appImage"]], note: d.linuxNote },
] as const;

const plugins = [
  ["@frameshell/whisper-cpp", t.plugins.whisper],
  ["@frameshell/hyperframes", t.plugins.hyperframes],
  ["@frameshell/remotion", t.plugins.remotion],
];
---

<section id="start" class="start" data-marker={t.marker}>
  <div class="wrap">
    <h2 class="display">{t.title}</h2>

    <ol class="steps">
      <li>
        <h3>{d.title}</h3>
        <div class="dl">
          {
            downloads.map((d) => (
              <div class="dl-row">
                <span class="os">{d.os}</span>
                <span class="links">
                  {d.items.map(([label, key]) => (
                    <a href={assetUrl(version, key)} data-asset={key}>
                      {label}
                    </a>
                  ))}
                </span>
                <span class="note">{d.note}</span>
              </div>
            ))
          }
        </div>
        <p class="all">{d.allBefore} <a href={RELEASES}>{d.releasePage}</a>{d.allAfter}</p>
      </li>
      <li>
        <h3>{t.folder.title}</h3>
        <p>{t.folder.body}</p>
        <div class="cmd"><code>frameshell init</code><button type="button" data-copy>{copy}</button></div>
        <p class="aside">{t.folder.aside}</p>
      </li>
      <li>
        <h3>{t.plugins.title}</h3>
        <p>{t.plugins.body}</p>
        <div class="plugins">
          {
            plugins.map(([name, what]) => (
              <div>
                <div class="cmd">
                  <code>frameshell plugin install {name}</code>
                  <button type="button" data-copy>{copy}</button>
                </div>
                <span class="aside">{what}</span>
              </div>
            ))
          }
        </div>
      </li>
      <li>
        <h3>{t.ask.title}</h3>
        <p set:html={t.ask.body} />
        <p class="all"><a href={pathFor((Astro.currentLocale ?? "en") as Lang, "agents")}>{t.ask.more}</a></p>
      </li>
    </ol>
  </div>
</section>

<style>
  .start {
    padding-block: clamp(56px, 8vw, 110px);
  }

  h2 {
    font-size: clamp(2.3rem, 6vw, 5rem);
  }

  .steps {
    margin: clamp(40px, 6vw, 72px) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps > li {
    position: relative;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 10px 40px;
    padding: 28px 0 32px;
    border-top: 1px solid var(--line);
    counter-increment: step;
  }

  .steps > li > :not(h3) {
    grid-column: 2;
  }

  h3 {
    grid-row: 1 / span 4;
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    font-stretch: 112%;
    line-height: 1.25;
  }

  h3::before {
    content: counter(step);
    display: block;
    margin-bottom: 6px;
    color: var(--tally);
    font: 500 14px var(--mono);
  }

  p {
    margin: 0;
    max-width: 62ch;
    color: var(--muted);
  }

  p code {
    color: var(--text);
  }

  .aside {
    color: var(--faint);
    font-size: 14px;
  }

  .dl {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .dl-row {
    display: grid;
    grid-template-columns: 110px auto minmax(0, 1fr);
    align-items: baseline;
    gap: 8px 24px;
    padding: 14px 18px;
  }

  .dl-row + .dl-row {
    border-top: 1px solid var(--line-soft);
  }

  .os {
    font-weight: 700;
    font-stretch: 110%;
  }

  .links {
    display: flex;
    gap: 16px;
  }

  .links a {
    color: var(--tally);
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .note {
    color: var(--faint);
    font-size: 14px;
  }

  .all {
    font-size: 14px;
  }

  .plugins {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  .plugins .aside {
    display: block;
    margin-top: 4px;
  }

  @media (max-width: 760px) {
    .steps > li {
      grid-template-columns: minmax(0, 1fr);
    }

    .steps > li > :not(h3) {
      grid-column: 1;
    }

    h3 {
      grid-row: auto;
    }

    .dl-row {
      grid-template-columns: 90px minmax(0, 1fr);
    }

    .note {
      grid-column: 1 / -1;
    }
  }
</style>
