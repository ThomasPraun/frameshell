---
import { strings } from "../i18n";

const t = strings(Astro.currentLocale).workflows;
// Tag colour per op, by position: Subtitles is a subtitle track, Shorts a video export.
const opClass = ["", "", "sub", "", "vid"];
---

<section class="flows" data-marker={t.marker}>
  <div class="wrap">
    <h2 class="display">{t.title}</h2>
    <div class="pair">
      <article>
        <h3>{t.recording.title}</h3>
        <p>{t.recording.body}</p>
        <ul class="ops">
          {t.recording.ops.map((op, i) => <li class={opClass[i] || undefined}>{op}</li>)}
        </ul>
      </article>
      <article>
        <h3>{t.script.title}</h3>
        <p>{t.script.body}</p>
        <pre class="doc"><code><span class="h">{t.script.hook}</span>
{t.script.hookLine}
<span class="m">{t.script.clip}</span>

<span class="h">{t.script.spot}</span>
{t.script.spotLine}</code></pre>
      </article>
    </div>
  </div>
</section>

<style>
  .flows {
    padding-block: clamp(56px, 8vw, 110px);
  }

  h2 {
    font-size: clamp(2.3rem, 6vw, 5rem);
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 5vw, 72px);
    margin-top: clamp(40px, 6vw, 72px);
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  h3 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    font-stretch: 118%;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  p {
    margin: 0;
    max-width: 52ch;
    color: var(--muted);
  }

  .doc {
    margin: 10px 0 0;
    padding: 18px 20px;
    border-left: 3px solid var(--sub);
    background: var(--panel);
    color: var(--text);
    font-size: 13.5px;
    line-height: 1.7;
    overflow-x: auto;
  }

  .h {
    color: var(--sub);
    font-weight: 700;
  }

  .m {
    color: var(--faint);
  }

  .ops {
    display: flex;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    gap: 3px;
  }

  .ops li {
    flex: 1;
    min-width: 0;
    padding: 34px 10px 10px;
    border-radius: 3px;
    background: #2f4a3c;
    box-shadow: inset 0 3px 0 var(--audio);
    font-size: 13.5px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ops li.sub {
    background: #4a3a55;
    box-shadow: inset 0 3px 0 var(--sub);
  }

  .ops li.vid {
    background: #3f5373;
    box-shadow: inset 0 3px 0 var(--video);
  }

  @media (max-width: 760px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }

    .ops {
      flex-wrap: wrap;
    }

    .ops li {
      flex: 1 1 30%;
    }
  }
</style>
