---
import Logo from "./Logo.astro";
import { REPO } from "../site";
import { strings, pathFor, type Lang } from "../i18n";

const lang = (Astro.currentLocale ?? "en") as Lang;
const t = strings(lang).footer;
---

<footer class="footer">
  <div class="wrap row">
    <div class="brand">
      <Logo size={22} />
      <span>frameshell</span>
    </div>
    <nav aria-label={t.nav}>
      <a href={pathFor(lang, "docs")}>{t.docs}</a>
      <a href={pathFor(lang, "docs", "faq")}>{t.faq}</a>
      <a href={REPO}>GitHub</a>
      <a href={`${REPO}/blob/main/docs/SPEC.md`}>{t.spec}</a>
      <a href={`${REPO}/blob/main/docs/mcp.md`}>{t.mcp}</a>
      <a href={`${REPO}/blob/main/LICENSE`}>{t.license}</a>
      {/* SignPath Foundation asks for "Code signing policy" on the home page (ADR 0051). */}
      <a href={`${REPO}/blob/main/CODE_SIGNING_POLICY.md`}>{t.signing}</a>
      <a href={`${REPO}/blob/main/PRIVACY.md`}>{t.privacy}</a>
    </nav>
  </div>
  <p class="wrap legal">
    {t.legal}
  </p>
</footer>

<style>
  .footer {
    padding-block: 40px 48px;
    border-top: 1px solid var(--line-soft);
    font-size: 14px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 800;
    font-stretch: 125%;
    font-size: 16px;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  .legal {
    margin-top: 24px;
    margin-bottom: 0;
    color: var(--faint);
    font-size: 13px;
  }
</style>
