---
import Logo from "./Logo.astro";
import { REPO } from "../site";
import { strings } from "../i18n";

const t = strings(Astro.currentLocale).footer;
---

<footer class="footer">
  <div class="wrap row">
    <div class="brand">
      <Logo size={22} />
      <span>frameshell</span>
    </div>
    <nav aria-label={t.nav}>
      <a href={REPO}>GitHub</a>
      <a href={`${REPO}/blob/main/docs/SPEC.md`}>{t.spec}</a>
      <a href={`${REPO}/blob/main/docs/mcp.md`}>{t.mcp}</a>
      <a href={`${REPO}/blob/main/LICENSE`}>{t.license}</a>
    </nav>
  </div>
  <p class="wrap legal">
    {t.legal}
  </p>
</footer>

<style>
  .footer {
    padding-block: 40px 48px;
    border-top: 1px solid var(--line-soft);
    font-size: 14px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 800;
    font-stretch: 125%;
    font-size: 16px;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  .legal {
    margin-top: 24px;
    margin-bottom: 0;
    color: var(--faint);
    font-size: 13px;
  }
</style>
