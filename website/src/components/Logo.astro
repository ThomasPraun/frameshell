---
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg width={size} height={size} viewBox="200 230 624 564" aria-hidden="true" class="logo-mark">
  <defs>
    <linearGradient id="logo-accent" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffb347"></stop>
      <stop offset="0.55" stop-color="#ff6a3d"></stop>
      <stop offset="1" stop-color="#e8336f"></stop>
    </linearGradient>
  </defs>
  <g fill="none" stroke="currentColor" stroke-width="40" stroke-linecap="round" stroke-linejoin="round">
    <path d="M232 352 V262 H322"></path>
    <path d="M702 262 H792 V352"></path>
    <path d="M792 672 V762 H702"></path>
    <path d="M322 762 H232 V672"></path>
  </g>
  <path d="M372 392 L532 512 L372 632" fill="none" stroke="url(#logo-accent)" stroke-width="68" stroke-linecap="round" stroke-linejoin="round"></path>
  <rect x="560" y="600" width="130" height="58" rx="29" fill="url(#logo-accent)"></rect>
</svg>
