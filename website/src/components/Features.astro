---
import { strings } from "../i18n";

const t = strings(Astro.currentLocale).features;
const words = t.transcript.words;
const layerColors = ["var(--video)", "var(--audio)", "var(--sub)", "var(--tally)", "var(--gen)"];
// Multicam demo angles, by position: wide, host (left of the clip), guest (right). Each is a crop
// of the carousel's poster, the same framing the carousel's close shots use.
const angleKind = ["wide", "host", "guest"];
const anglePic = [
  "background-size: 100%; background-position: 50% 50%",
  "background-size: 160%; background-position: 6% 36%",
  "background-size: 170%; background-position: 88% 36%",
];
const startShots = [1, 2, 0, 1];
const personColors = ["var(--gen)", "var(--sub)", "var(--audio)", "var(--video)"];
const sampleLang = ["en", "es"];
const pageLang = Astro.currentLocale === "es" ? 1 : 0;
---

<section id="features" class="features" data-marker={t.marker}>
  <div class="wrap">
    <h2 class="display">{t.title}</h2>

    <div class="grid">
      <article class="cell span-2">
        <h3>{t.transcript.title}</h3>
        <p>{t.transcript.body}</p>
        <div class="tx" data-tx>
          <p class="tx-words">
            {
              words.map(([w, , cut], i) => (
                <button type="button" class:list={{ struck: cut }} data-i={i} aria-pressed={cut ? "true" : "false"}>
                  {w}
                </button>
              ))
            }
          </p>
          <div class="tx-bar" aria-hidden="true">
            {words.map(([, d, cut]) => <span style={`--d:${d}`} class:list={{ gone: cut }} />)}
          </div>
          <p class="tx-dur" aria-live="polite" data-tx-dur></p>
        </div>
      </article>

      <article class="cell">
        <h3>{t.review.title}</h3>
        <p>{t.review.body}</p>
        <ol class="hist" data-hist>
          {
            t.review.steps.map((what, i) => (
              <li>
                <span class:list={["by", i === 1 ? "you" : "agent"]}>{i === 1 ? t.review.you : "claude"}</span>
                <span class="what">{what}</span>
                <button type="button">{t.review.revert}</button>
              </li>
            ))
          }
        </ol>
      </article>

      <article class="cell">
        <h3>{t.layers.title}</h3>
        <p>{t.layers.body}</p>
        <ul class="engines layers">
          {t.layers.items.map((item, i) => <li style={`--c: ${layerColors[i]}`}>{item}</li>)}
        </ul>
      </article>

      <article class="cell">
        <h3>{t.engines.title}</h3>
        <p>{t.engines.body}</p>
        <ul class="engines">
          {t.engines.items.map((e) => <li>{e}</li>)}
        </ul>
      </article>

      <article class="cell">
        <h3>{t.export.title}</h3>
        <p>{t.export.body}</p>
        <ul class="engines presets">
          <li>youtube-1080p</li>
          <li>youtube-1440p</li>
          <li>vertical-1080x1920</li>
        </ul>
      </article>

      <article class="cell span-2">
        <h3>{t.multicam.title}</h3>
        <p>{t.multicam.body}</p>
        <div class="mc" data-mc>
          <div class="mc-angles">
            {
              t.multicam.angles.map((name, i) => (
                <button type="button" class:list={["mc-angle", angleKind[i]]} data-angle={i} data-kind={angleKind[i]} aria-pressed={i === 1 ? "true" : "false"}>
                  <span class="mc-pic" style={anglePic[i]} />
                  <kbd>{i + 1}</kbd>
                  <span class="mc-name">{name}</span>
                </button>
              ))
            }
          </div>
          <div class="mc-track">
            <span class="mc-label">{t.multicam.program}</span>
            <ol class="mc-shots" data-mc-shots aria-hidden="true">
              {startShots.map((a) => <li class={angleKind[a]} data-a={a}>{t.multicam.angles[a]}</li>)}
            </ol>
          </div>
          <p class="mc-hint">{t.multicam.hint}</p>
        </div>
      </article>

      <article class="cell">
        <h3>{t.gallery.title}</h3>
        <p>{t.gallery.body}</p>
        <div class="call" aria-hidden="true">
          {
            t.gallery.people.map((name, i) => (
              <span class="tile" style={`--d: ${(0.25 * i).toFixed(2)}s`}>
                <span class="face" style={`--c: ${personColors[i]}`} />
                <span class="tile-name">{name}</span>
              </span>
            ))
          }
        </div>
        <p class="call-out mono">{t.gallery.angles}</p>
      </article>

      <article class="cell span-2">
        <h3>{t.director.title}</h3>
        <p>{t.director.body}</p>
        <div class="cmd mini"><code>frameshell direct podcast --template interview</code></div>
        <ol class="dir">
          {
            t.director.shots.map(([at, shot, reason, confidence]) => (
              <li class:list={{ low: confidence < 0.5 }}>
                <span class="dir-at">{at}</span>
                <span class="dir-shot">{shot}</span>
                <span class="dir-why">{reason}</span>
                <span class="dir-conf">
                  <span class="meter" style={`--v: ${confidence}`} />
                  {confidence.toFixed(2)}
                </span>
                <span class="dir-flag">{confidence < 0.5 ? t.director.review : ""}</span>
              </li>
            ))
          }
        </ol>
      </article>

      <article class="cell">
        <h3>{t.language.title}</h3>
        <p>{t.language.body}</p>
        <div class="lang" data-lang-demo={JSON.stringify(t.language.samples)}>
          <div class="lang-pick">
            {
              t.language.samples.map(([name], i) => (
                <button type="button" lang={sampleLang[i]} data-lang-i={i} aria-pressed={i === pageLang ? "true" : "false"}>
                  {name}
                </button>
              ))
            }
          </div>
          <span class="lang-sample" lang={sampleLang[pageLang]} data-lang-sample aria-live="polite">{t.language.samples[pageLang][1]}</span>
        </div>
      </article>

      <article class="cell">
        <h3>{t.json.title}</h3>
        <p>{t.json.body}</p>
      </article>

      <article class="cell span-2">
        <h3>{t.mcp.title}</h3>
        <p>{t.mcp.body}</p>
        <div class="cmd mini"><code>claude mcp add frameshell -- frameshell mcp</code></div>
      </article>
    </div>
  </div>
</section>

<style>
  .features {
    padding-block: clamp(56px, 8vw, 110px);
  }

  h2 {
    max-width: 16ch;
    font-size: clamp(2.3rem, 6vw, 5rem);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(40px, 6vw, 72px);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--line);
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: clamp(22px, 2.6vw, 34px);
    background: var(--ink);
  }

  .span-2 {
    grid-column: span 2;
  }

  h3 {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .cell > p {
    margin: 0;
    max-width: 52ch;
    color: var(--muted);
    font-size: 15.5px;
  }

  /* Transcript */
  .tx {
    margin-top: auto;
    padding-top: 18px;
  }

  .tx-words {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 0;
    margin: 0;
    font-size: clamp(1.25rem, 2.3vw, 1.75rem);
    font-weight: 600;
    font-stretch: 105%;
  }

  .tx-words button {
    padding: 0 0.16em;
    border: 0;
    border-radius: 3px;
    background: none;
    color: var(--text);
    font: inherit;
    cursor: default;
    transition:
      color 0.2s,
      background-color 0.4s;
  }

  .tx-words button.struck {
    color: var(--faint);
    text-decoration: line-through 2px var(--danger);
    cursor: pointer;
  }

  .tx-words button.struck:hover {
    background: var(--panel);
  }

  .tx-words button.restored {
    background: var(--tally-soft);
  }

  .tx-bar {
    display: flex;
    gap: 2px;
    height: 22px;
    margin-top: 16px;
  }

  .tx-bar span {
    flex: var(--d) 0 0;
    border-radius: 2px;
    background: #2f4a3c;
    box-shadow: inset 0 2px 0 var(--audio);
    transition:
      flex-grow 0.6s var(--ease),
      margin 0.6s var(--ease);
  }

  .tx-bar span.gone {
    flex-grow: 0;
    margin-right: -2px;
  }

  .tx-dur {
    margin: 8px 0 0;
    color: var(--faint);
    font: 12.5px var(--mono);
  }

  /* History */
  .hist {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: auto 0 0;
    padding: 18px 0 0;
    list-style: none;
    font-size: 14px;
  }

  .hist :global(li) {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 7px 8px 7px 10px;
    border-radius: 4px;
    background: var(--panel);
    animation: slot 0.4s var(--ease);
  }

  @keyframes slot {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .hist :global(li.reverted .what) {
    color: var(--faint);
    text-decoration: line-through;
  }

  .hist :global(.by) {
    font: 500 12px var(--mono);
  }

  .hist :global(.by.agent) {
    color: var(--gen);
  }

  .hist :global(.by.you) {
    color: var(--tally);
  }

  .hist :global(.what) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hist :global(button) {
    padding: 3px 9px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: none;
    color: var(--muted);
    font: 500 12.5px var(--sans);
    cursor: pointer;
  }

  .hist :global(button:hover:not(:disabled)) {
    border-color: var(--faint);
    color: var(--text);
  }

  .hist :global(button:disabled) {
    visibility: hidden;
  }

  .code {
    margin: auto 0 0;
    padding: 14px 16px;
    overflow-x: auto;
    border-radius: 6px;
    background: var(--panel);
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.6;
  }

  .k {
    color: var(--video);
  }

  .s {
    color: var(--audio);
  }

  .n {
    color: var(--tally);
  }

  .engines {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: auto 0 0;
    padding: 12px 0 0;
    list-style: none;
  }

  .engines li {
    padding: 5px 10px;
    border-radius: 3px;
    background: var(--panel);
    box-shadow: inset 0 2px 0 var(--gen);
    font-size: 13.5px;
  }

  .engines li:first-child {
    box-shadow: inset 0 2px 0 var(--video);
  }

  .layers li,
  .layers li:first-child,
  .layers li:last-child {
    box-shadow: inset 0 2px 0 var(--c);
    color: var(--text);
  }

  .presets li,
  .presets li:first-child,
  .presets li:last-child {
    box-shadow: none;
    color: var(--text);
    font-family: var(--mono);
    font-size: 12.5px;
  }

  .engines li:last-child {
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--muted);
  }

  .mini {
    margin-top: auto;
    font-size: 12.5px;
  }

  /* Multicam: angle tiles that cut the program track below them. */
  .mc {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: auto;
    padding-top: 18px;
  }

  .mc-angles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .mc-angle {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 0;
    border-radius: 5px;
    overflow: hidden;
    background: #0b0b0c;
    color: var(--text);
    font: inherit;
    cursor: pointer;
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .mc-pic {
    position: absolute;
    inset: 0;
    background-image: url(/media/podcast-poster.jpg);
    background-repeat: no-repeat;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .mc-angle:hover .mc-pic,
  .mc-angle[aria-pressed="true"] .mc-pic {
    opacity: 1;
  }

  .mc-angle[aria-pressed="true"]::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 2px var(--c);
  }

  .mc-angle kbd,
  .mc-name {
    position: absolute;
    bottom: 6px;
    padding: 1px 6px;
    border-radius: 3px;
    background: rgba(15, 15, 18, 0.72);
    font-size: 12px;
  }

  .mc-angle kbd {
    left: 6px;
    color: var(--c);
    font-weight: 600;
  }

  .mc-name {
    right: 6px;
    max-width: calc(100% - 44px);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .mc :global(.wide) {
    --c: var(--video);
    --c-dark: #3f5373;
  }

  .mc :global(.host) {
    --c: var(--gen);
    --c-dark: #2b5260;
  }

  .mc :global(.guest) {
    --c: var(--sub);
    --c-dark: #4a3a55;
  }

  .mc-track {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 10px;
  }

  .mc-label {
    color: var(--muted);
    font-size: 12.5px;
  }

  .mc-shots {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
  }

  .mc-shots :global(li) {
    flex: 1 1 0;
    min-width: 0;
    padding: 0 7px;
    border-radius: 3px;
    background: var(--c-dark);
    box-shadow: inset 0 2px 0 var(--c);
    font-size: 12px;
    line-height: 26px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mc-shots :global(li.fresh) {
    animation: cutIn 0.45s var(--ease);
  }

  @keyframes cutIn {
    from {
      flex-grow: 0.001;
      opacity: 0.4;
    }
  }

  .mc-hint {
    margin: 0;
    color: var(--faint);
    font-size: 13px;
  }

  /* Call recorded in gallery view: each tile gets cut out as an angle. */
  .call {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
    margin-top: auto;
    padding: 6px;
    border-radius: 6px;
    background: #0b0b0c;
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .tile {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border-radius: 3px;
    background: var(--raised);
  }

  /* Dashed crop marks drawn over each tile. */
  .tile::after {
    content: "";
    position: absolute;
    inset: -2px;
    border: 1.5px dashed var(--tally);
    border-radius: 4px;
    opacity: 0.85;
  }

  .face {
    width: 34%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 38%, var(--c) 0 26%, transparent 27%),
      radial-gradient(ellipse 60% 44% at 50% 100%, var(--c) 0 98%, transparent 100%);
    opacity: 0.75;
  }

  .tile-name {
    position: absolute;
    left: 5px;
    bottom: 4px;
    padding: 0 5px;
    border-radius: 2px;
    background: rgba(15, 15, 18, 0.7);
    font-size: 11.5px;
  }

  .call-out {
    margin: 0;
    color: var(--tally);
    font: 12.5px var(--mono);
  }

  /* Director's shots: when, which, why and how sure. */
  .dir {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }

  .dir li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1.2fr) minmax(0, 1fr) 96px 56px;
    align-items: center;
    gap: 12px;
    padding: 6px 10px;
    border-radius: 4px;
    background: var(--panel);
  }

  .dir-at,
  .dir-conf {
    color: var(--faint);
    font: 12.5px var(--mono);
  }

  .dir-shot,
  .dir-why {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .dir-why {
    color: var(--muted);
  }

  .dir-conf {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .meter {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--audio) calc(var(--v) * 100%), var(--line) 0);
  }

  .dir .low .meter {
    background: linear-gradient(90deg, var(--danger) calc(var(--v) * 100%), var(--line) 0);
  }

  .dir-flag {
    color: var(--danger);
    font-size: 12.5px;
    text-align: right;
  }

  /* Language switch, showing the welcome button in the chosen language. */
  .lang {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin-top: auto;
    padding-top: 18px;
  }

  .lang-pick {
    display: inline-flex;
    padding: 3px;
    border-radius: 6px;
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .lang-pick button {
    min-height: 34px;
    padding: 0 14px;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--muted);
    font: 600 14px var(--sans);
    cursor: pointer;
  }

  .lang-pick button[aria-pressed="true"] {
    background: var(--hover);
    color: var(--text);
  }

  .lang-sample {
    padding: 9px 16px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--text);
    font-size: 14.5px;
    font-weight: 600;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: dense;
    }
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .span-2 {
      grid-column: auto;
    }

    .dir li {
      grid-template-columns: 40px minmax(0, 1fr) 84px;
      gap: 4px 10px;
    }

    .dir-why {
      grid-column: 2;
      grid-row: 2;
      font-size: 13px;
    }

    .dir-flag {
      grid-column: 3;
      grid-row: 2;
    }
  }
</style>

<script>
  import { runtime } from "../scripts/i18n";

  const strs = runtime();
  const tx = document.querySelector<HTMLElement>("[data-tx]");
  if (tx) {
    const buttons = [...tx.querySelectorAll<HTMLButtonElement>("button")];
    const bars = [...tx.querySelectorAll<HTMLElement>(".tx-bar span")];
    const out = tx.querySelector<HTMLElement>("[data-tx-dur]")!;
    const dur = (el: HTMLElement) => Number(el.style.getPropertyValue("--d"));
    const total = bars.reduce((a, b) => a + dur(b), 0);
    const render = () => {
      const kept = bars.filter((b) => !b.classList.contains("gone")).reduce((a, b) => a + dur(b), 0);
      out.textContent = strs.kept.replace("{kept}", kept.toFixed(1)).replace("{total}", total.toFixed(1));
    };
    buttons.forEach((b, i) =>
      b.addEventListener("click", () => {
        if (!b.classList.contains("struck")) return;
        b.classList.replace("struck", "restored");
        b.setAttribute("aria-pressed", "false");
        bars[i].classList.remove("gone");
        render();
      }),
    );
    render();
  }

  // Multicam: a click or a number key cuts to that angle, adding a shot to the program track.
  const mc = document.querySelector<HTMLElement>("[data-mc]");
  if (mc) {
    const angles = [...mc.querySelectorAll<HTMLButtonElement>("[data-angle]")];
    const shots = mc.querySelector<HTMLOListElement>("[data-mc-shots]")!;
    const cut = (a: number) => {
      const btn = angles[a];
      if (!btn) return;
      angles.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      const li = document.createElement("li");
      li.className = btn.dataset.kind + " fresh";
      li.textContent = btn.querySelector(".mc-name")!.textContent;
      shots.append(li);
      while (shots.children.length > 6) shots.firstElementChild!.remove();
    };
    angles.forEach((b, i) => b.addEventListener("click", () => cut(i)));
    mc.addEventListener("keydown", (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      const n = Number(e.key);
      if (n >= 1 && n <= angles.length) {
        e.preventDefault();
        cut(n - 1);
        angles[n - 1].focus();
      }
    });
  }

  const lang = document.querySelector<HTMLElement>("[data-lang-demo]");
  if (lang) {
    const sample = lang.querySelector<HTMLElement>("[data-lang-sample]")!;
    const samples = JSON.parse(lang.dataset.langDemo!) as [string, string][];
    const buttons = [...lang.querySelectorAll<HTMLButtonElement>("[data-lang-i]")];
    buttons.forEach((b, i) =>
      b.addEventListener("click", () => {
        buttons.forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
        sample.textContent = samples[i][1];
        sample.lang = b.lang;
      }),
    );
  }

  const hist = document.querySelector<HTMLOListElement>("[data-hist]");
  hist?.addEventListener("click", (e) => {
    const button = (e.target as Element).closest("button");
    const row = button?.closest("li");
    if (!button || !row) return;
    const what = row.querySelector(".what")!.textContent;
    row.classList.add("reverted");
    button.disabled = true;
    const undo = document.createElement("li");
    undo.innerHTML = '<span class="by you"></span><span class="what"></span><button type="button" disabled></button>';
    undo.querySelector(".by")!.textContent = strs.you;
    undo.querySelector(".what")!.textContent = strs.revertOf.replace("{what}", what ?? "");
    undo.querySelector("button")!.textContent = strs.revert;
    hist.prepend(undo);
    while (hist.children.length > 4) hist.lastElementChild!.remove();
  });
</script>
