---
import Logo from "./Logo.astro";
import { REPO, RELEASES } from "../site";
import { strings, pathFor, type Lang } from "../i18n";

const lang = (Astro.currentLocale ?? "en") as Lang;
const t = strings(lang).header;
const other: Lang = lang === "en" ? "es" : "en";
---

<header class="header">
  <div class="wrap bar">
    <a class="brand" href={pathFor(lang)} aria-label={t.home}>
      <Logo />
      <span>frameshell</span>
    </a>
    <nav aria-label={t.nav}>
      <a href="#features">{t.features}</a>
      <a href="#start">{t.start}</a>
      <a href={`${REPO}/blob/main/docs/SPEC.md`}>{t.docs}</a>
      <a href={REPO} class="gh">
        <svg viewBox="0 0 16 16" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.34.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"
          ></path></svg
        >
        <span>GitHub</span>
      </a>
      <a class="lang" href={pathFor(other)} hreflang={other} lang={other} aria-label={t.switchAria} data-lang={other}
        >{t.switchLabel}</a
      >
      <a class="btn btn-primary btn-sm" href={RELEASES} data-download>{t.download}</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid transparent;
    background: rgba(20, 21, 23, 0.72);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    transition: border-color 0.3s;
  }

  :global(html.scrolled) .header {
    border-bottom-color: var(--line-soft);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    font-stretch: 125%;
    font-size: 19px;
    letter-spacing: -0.02em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 15px;
  }

  nav a:not(.btn) {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  nav a:not(.btn):hover {
    color: var(--text);
  }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .gh svg {
    width: 17px;
    height: 17px;
  }

  nav .lang {
    font: 500 13px var(--mono);
  }

  .btn-sm {
    height: 36px;
    padding: 0 16px;
    font-size: 14px;
  }

  @media (max-width: 760px) {
    nav {
      gap: 18px;
    }

    nav a[href^="#"],
    nav a[href*="SPEC"] {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .gh span {
      display: none;
    }
  }
</style>
