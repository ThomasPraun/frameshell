{
  "name": "@frameshell/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Frameshell desktop app: Electron shell with explorer, editor, preview, timeline and terminals.",
  "license": "Apache-2.0",
  "author": "Frameshell contributors",
  "homepage": "https://github.com/ThomasPraun/frameshell",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-native.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test:e2e": "electron-vite build && playwright test",
    "package": "electron-vite build && node scripts/release/package.mjs",
    "package:dir": "electron-vite build && node scripts/release/package.mjs --dir"
  },
  "dependencies": {
    "@frameshell/cli": "workspace:*",
    "@frameshell/core": "workspace:*",
    "@frameshell/protocol": "workspace:*",
    "@frameshell/schema": "workspace:*",
    "chokidar": "^5.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "monaco-editor": "^0.57.0",
    "mp4box": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.6"
  }
}
