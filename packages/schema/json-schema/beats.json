{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "asset": {
      "type": "string",
      "minLength": 1
    },
    "assetHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "detector": {
      "type": "string",
      "pattern": "^(exact|[a-z][a-z0-9-]*@\\d+)$"
    },
    "sampleRate": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "bpm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "meter": {
      "default": 4,
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "downbeat": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "residualMs": {
      "type": "number",
      "minimum": 0
    },
    "beats": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "onsets": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tempo": {
            "type": "string",
            "enum": [
              "double",
              "half"
            ]
          },
          "bpm": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "tempo",
          "bpm"
        ],
        "additionalProperties": false
      }
    },
    "edits": {
      "default": {},
      "type": "object",
      "properties": {
        "tempo": {
          "description": "Calm music gets a double-time grid, fast music a half-time one: `double` adds a beat halfway between each pair, `half` keeps every other beat.",
          "type": "string",
          "enum": [
            "double",
            "half"
          ]
        },
        "downbeat": {
          "description": "Index (from 0) among the effective beats of the first beat that starts a bar; bars repeat every `meter` beats from there.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "offset": {
          "description": "Seconds added to every beat, to nudge a grid that sits early or late.",
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "asset",
    "assetHash",
    "detector",
    "bpm",
    "confidence",
    "beats"
  ],
  "additionalProperties": false,
  "$id": "https://frameshell.dev/schema/v1/beats.json"
}
