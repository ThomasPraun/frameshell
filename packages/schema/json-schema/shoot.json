{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "script": {
      "type": "string",
      "minLength": 1,
      "description": "Project-relative shoot script, e.g. `scripts/launch.md`."
    },
    "timeline": {
      "description": "Timeline the first cut is assembled into; default the script slug.",
      "type": "string",
      "minLength": 1
    },
    "takes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^k_[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "asset": {
            "type": "string",
            "minLength": 1,
            "description": "Project-relative media file, `/`-separated, e.g. `assets/hook-2.mp4`; for a session take its microphone file."
          },
          "scene": {
            "type": "string",
            "minLength": 1,
            "description": "Slug of the scene the take starts at, as the person or app named it; the comparison finds where it really starts."
          },
          "recordedAt": {
            "type": "string",
            "minLength": 1,
            "description": "ISO 8601 time the take was recorded (or linked); newer takes are chosen by default."
          },
          "discarded": {
            "description": "True when the take is set aside: never chosen, still listed.",
            "type": "boolean"
          },
          "by": {
            "description": "Author that linked the take, e.g. `cli` or `agent:claude:s1`.",
            "type": "string",
            "minLength": 1
          },
          "session": {
            "description": "Set for a take recorded in the app: its range of the session; absent for a whole imported file.",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^\\d{8}-\\d{6}(-\\d+)?$"
              },
              "start": {
                "type": "number",
                "minimum": 0,
                "description": "Session-clock second the take starts (key `T`)."
              },
              "end": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Session-clock second the take ends (key `C`); after `start`."
              },
              "sounds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "asset": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Project-relative file, e.g. `assets/shoot/20261024-153012/mic.m4a`; recorded as `<file>.part` until the session ends."
                    },
                    "offset": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Session-clock second at which the file's time 0 plays."
                    }
                  },
                  "required": [
                    "asset",
                    "offset"
                  ],
                  "additionalProperties": false
                },
                "description": "The microphone first, then system audio when it was on."
              },
              "group": {
                "description": "Multicam group made of the session once it ended; absent while it records.",
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "start",
              "end",
              "sounds"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "asset",
          "scene",
          "recordedAt"
        ],
        "additionalProperties": false
      }
    },
    "chosen": {
      "default": {},
      "description": "Scene slug to the take the person picked; scenes not here use the newest take covering them.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^k_[A-Za-z0-9][A-Za-z0-9_-]*$"
      }
    },
    "accepted": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "take": {
            "type": "string",
            "pattern": "^k_[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "deviation": {
            "type": "string",
            "minLength": 1,
            "description": "Deviation id from `shoot.status`; it stays the same while the script line and the heard words stay the same."
          },
          "by": {
            "type": "string",
            "minLength": 1,
            "description": "Author that accepted it."
          },
          "at": {
            "type": "string",
            "minLength": 1,
            "description": "ISO 8601 time it was accepted."
          }
        },
        "required": [
          "take",
          "deviation",
          "by",
          "at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "script"
  ],
  "additionalProperties": false,
  "$id": "https://frameshell.dev/schema/v1/shoot.json"
}
