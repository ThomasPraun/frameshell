{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Bumped by the core on every applied operation; stale direct edits are rejected."
    },
    "tracks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable, core-generated (`t_…`)."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "video",
                  "audio"
                ]
              },
              "name": {
                "type": "string"
              },
              "clips": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Stable, core-generated (`c_…`); reference clips by it."
                        },
                        "start": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Timeline seconds of the first frame."
                        },
                        "scriptRef": {
                          "description": "Script scene this clip realizes: `scripts/<file>.md#<anchor>`; without `#anchor`, the whole script.",
                          "type": "string",
                          "minLength": 1
                        },
                        "transform": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "description": "Horizontal offset in project pixels from the centered position. Default 0.",
                              "type": "number"
                            },
                            "y": {
                              "description": "Vertical offset in project pixels from the centered position. Default 0.",
                              "type": "number"
                            },
                            "scale": {
                              "description": "Uniform scale factor. Default 1.",
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "opacity": {
                              "description": "0 (invisible) to 1 (opaque). Default 1.",
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "additionalProperties": false,
                          "description": "Overlay placement (video tracks only)."
                        },
                        "audio": {
                          "type": "object",
                          "properties": {
                            "gain": {
                              "description": "Gain in dB; 0 = unchanged, negative = quieter. Default 0.",
                              "type": "number"
                            },
                            "muted": {
                              "description": "Default false.",
                              "type": "boolean"
                            }
                          },
                          "additionalProperties": false
                        },
                        "type": {
                          "type": "string",
                          "const": "media"
                        },
                        "asset": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Project-relative, `/`-separated, e.g. `assets/raw-01.mp4`."
                        },
                        "in": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Source seconds of the first frame."
                        },
                        "out": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "description": "Source seconds just after the last frame; greater than `in`."
                        },
                        "speed": {
                          "description": "Playback rate; 1 = normal, 2 = twice as fast. Default 1.",
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": [
                        "id",
                        "start",
                        "type",
                        "asset",
                        "in",
                        "out"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Stable, core-generated (`c_…`); reference clips by it."
                        },
                        "start": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Timeline seconds of the first frame."
                        },
                        "scriptRef": {
                          "description": "Script scene this clip realizes: `scripts/<file>.md#<anchor>`; without `#anchor`, the whole script.",
                          "type": "string",
                          "minLength": 1
                        },
                        "transform": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "description": "Horizontal offset in project pixels from the centered position. Default 0.",
                              "type": "number"
                            },
                            "y": {
                              "description": "Vertical offset in project pixels from the centered position. Default 0.",
                              "type": "number"
                            },
                            "scale": {
                              "description": "Uniform scale factor. Default 1.",
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "opacity": {
                              "description": "0 (invisible) to 1 (opaque). Default 1.",
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "additionalProperties": false,
                          "description": "Overlay placement (video tracks only)."
                        },
                        "audio": {
                          "type": "object",
                          "properties": {
                            "gain": {
                              "description": "Gain in dB; 0 = unchanged, negative = quieter. Default 0.",
                              "type": "number"
                            },
                            "muted": {
                              "description": "Default false.",
                              "type": "boolean"
                            }
                          },
                          "additionalProperties": false
                        },
                        "type": {
                          "type": "string",
                          "const": "timeline"
                        },
                        "source": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Project-relative timeline file, e.g. `timelines/intro.json`."
                        },
                        "in": {
                          "description": "Nested-timeline seconds of the first frame. Default 0.",
                          "type": "number",
                          "minimum": 0
                        },
                        "duration": {
                          "description": "Seconds played. Default: the rest of the nested timeline after `in`.",
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": [
                        "id",
                        "start",
                        "type",
                        "source"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Stable, core-generated (`c_…`); reference clips by it."
                        },
                        "start": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Timeline seconds of the first frame."
                        },
                        "scriptRef": {
                          "description": "Script scene this clip realizes: `scripts/<file>.md#<anchor>`; without `#anchor`, the whole script.",
                          "type": "string",
                          "minLength": 1
                        },
                        "transform": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "description": "Horizontal offset in project pixels from the centered position. Default 0.",
                              "type": "number"
                            },
                            "y": {
                              "description": "Vertical offset in project pixels from the centered position. Default 0.",
                              "type": "number"
                            },
                            "scale": {
                              "description": "Uniform scale factor. Default 1.",
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "opacity": {
                              "description": "0 (invisible) to 1 (opaque). Default 1.",
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "additionalProperties": false,
                          "description": "Overlay placement (video tracks only)."
                        },
                        "audio": {
                          "type": "object",
                          "properties": {
                            "gain": {
                              "description": "Gain in dB; 0 = unchanged, negative = quieter. Default 0.",
                              "type": "number"
                            },
                            "muted": {
                              "description": "Default false.",
                              "type": "boolean"
                            }
                          },
                          "additionalProperties": false
                        },
                        "type": {
                          "type": "string",
                          "pattern": "^(?!(?:media|timeline|shot)$)[a-z][a-z0-9-]*$",
                          "description": "Clip type registered by an adapter plugin, e.g. `hyperframes`."
                        },
                        "source": {
                          "description": "Project-relative composition entry, e.g. `compositions/hyperframes/intro/index.html`.",
                          "type": "string",
                          "minLength": 1
                        },
                        "in": {
                          "description": "Composition seconds of the first frame. Default 0.",
                          "type": "number",
                          "minimum": 0
                        },
                        "duration": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "description": "Seconds on the timeline."
                        },
                        "props": {
                          "description": "Adapter-specific properties, validated by the adapter.",
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        }
                      },
                      "required": [
                        "id",
                        "start",
                        "type",
                        "duration"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "description": "Sorted by `start`, never overlapping."
              }
            },
            "required": [
              "id",
              "kind",
              "clips"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable, core-generated (`t_…`)."
              },
              "kind": {
                "type": "string",
                "const": "program"
              },
              "name": {
                "type": "string"
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "description": "Id of the multicam group in the timeline's `groups`; one program track per group."
              },
              "clips": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Stable, core-generated (`c_…`); reference clips by it."
                    },
                    "type": {
                      "type": "string",
                      "const": "shot"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Timeline seconds of the first frame."
                    },
                    "in": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Group-clock seconds of the first frame."
                    },
                    "out": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "description": "Group-clock seconds just after the last frame; greater than `in`."
                    },
                    "shot": {
                      "type": "string",
                      "enum": [
                        "solo",
                        "two-up",
                        "grid",
                        "screen",
                        "pip"
                      ],
                      "description": "Layout: `solo` (one angle), `two-up` (two), `grid` (two or more), `screen` (one angle whole), `pip` (screen angle + inset)."
                    },
                    "angles": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": "Angle ids of the track's group, in layout order (left to right, then top to bottom); no repeats. `pip`: the screen first, then the inset."
                    },
                    "corner": {
                      "description": "`pip` only: corner of the inset. Default `bottom-right`.",
                      "type": "string",
                      "enum": [
                        "top-left",
                        "top-right",
                        "bottom-left",
                        "bottom-right"
                      ]
                    },
                    "confidence": {
                      "description": "Set by the director: 0 (a guess) to 1 (sure). Absent on shots a person chose.",
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "reason": {
                      "description": "Set by the director: why it chose this shot, in a few words.",
                      "type": "string",
                      "minLength": 1
                    },
                    "scriptRef": {
                      "description": "Script scene this clip realizes: `scripts/<file>.md#<anchor>`; without `#anchor`, the whole script.",
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "start",
                    "in",
                    "out",
                    "shot",
                    "angles"
                  ],
                  "additionalProperties": false
                },
                "description": "Shots, sorted by `start`, never overlapping."
              }
            },
            "required": [
              "id",
              "kind",
              "group",
              "clips"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "subtitles"
              },
              "name": {
                "type": "string"
              },
              "follows": {
                "type": "string",
                "minLength": 1,
                "description": "Id of the video or audio track whose clips supply the words."
              },
              "style": {
                "type": "object",
                "properties": {
                  "preset": {
                    "type": "string"
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "top",
                      "center",
                      "bottom"
                    ]
                  }
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "id",
              "kind",
              "follows"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "Stacking order: the first video track is the bottom layer."
    },
    "groups": {
      "description": "Multicam groups (ADR 0016), each shown by one program track.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable, core-generated (`g_…`); a program track names it in `group`."
          },
          "name": {
            "type": "string"
          },
          "angles": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Unique within the group; shots name angles by it."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Person or camera, e.g. `Ana`."
                },
                "asset": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Project-relative media file, e.g. `assets/ana.mp4`."
                },
                "offset": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Group-clock seconds at which the asset's time 0 plays: source time = group time - offset."
                },
                "crop": {
                  "type": "object",
                  "properties": {
                    "left": {
                      "description": "Default 0.",
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMaximum": 1
                    },
                    "top": {
                      "description": "Default 0.",
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMaximum": 1
                    },
                    "right": {
                      "description": "Default 0.",
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMaximum": 1
                    },
                    "bottom": {
                      "description": "Default 0.",
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMaximum": 1
                    }
                  },
                  "additionalProperties": false,
                  "description": "Fractions of the source picture (0 to below 1) cut off each side before a shot fills its tile with it."
                },
                "reframe": {
                  "description": "Where the picture is cut when a tile's aspect differs from it (a solo of a 16:9 camera in a 9:16 export): keys sorted by `at`, the point moving in a straight line between keys and held before the first and after the last; the cut never leaves the cropped picture. Absent: centered. Screens (`screen` shots, a `pip` screen) are never cut.",
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "at": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Group-clock second of the key."
                      },
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Point to center on across the picture: fraction of the source width, 0 left edge, 1 right edge."
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Point to center on down the picture: fraction of the source height, 0 top edge, 1 bottom edge."
                      }
                    },
                    "required": [
                      "at",
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  }
                },
                "audio": {
                  "description": "Gain and mute of the sound of this angle's own file, which plays under every shot. Absent with `mic` set: the mic carries the level.",
                  "type": "object",
                  "properties": {
                    "gain": {
                      "description": "Gain in dB; 0 = unchanged, negative = quieter. Default 0.",
                      "type": "number"
                    },
                    "muted": {
                      "description": "Default false.",
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "mic": {
                  "description": "Where this angle's person is heard. Absent: the sound of its own file. An id of the group's `mics`: that mic (one mic may serve several angles and plays once); the file's own sound is then not played. null: no sound (a wide camera); its own file's sound is not played either.",
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "screen": {
                  "description": "True: a screen share, not a person. The director shows it (`screen`, `pip`) while it moves and never as a speaker. Default false.",
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "name",
                "asset",
                "offset"
              ],
              "additionalProperties": false
            }
          },
          "mics": {
            "description": "Separate sound files of the group; angles pick theirs with `mic`. Absent: every angle has its own file's sound.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Unique among the group's angles and mics; angles name it in `mic`. Not `camera` or `none`."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Person or recorder, e.g. `Ana lav`."
                },
                "asset": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Project-relative file with sound, e.g. `assets/ana.wav`. Only its sound is used."
                },
                "offset": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Group-clock seconds at which the asset's time 0 plays: source time = group time - offset."
                },
                "audio": {
                  "description": "Gain and mute of this mic's sound, which plays under every shot, once even when several angles use it.",
                  "type": "object",
                  "properties": {
                    "gain": {
                      "description": "Gain in dB; 0 = unchanged, negative = quieter. Default 0.",
                      "type": "number"
                    },
                    "muted": {
                      "description": "Default false.",
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "name",
                "asset",
                "offset"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "angles"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "tracks"
  ],
  "additionalProperties": false,
  "$id": "https://frameshell.dev/schema/v1/timeline.json"
}
