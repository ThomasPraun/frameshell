{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Bumped by the core on every applied operation; stale direct edits are rejected."
    },
    "tracks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable, core-generated (`t_…`)."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "video",
                  "audio"
                ]
              },
              "name": {
                "type": "string"
              },
              "clips": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Stable, core-generated (`c_…`); reference clips by it."
                        },
                        "start": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Timeline seconds of the first frame."
                        },
                        "scriptRef": {
                          "description": "Script scene this clip realizes: `scripts/<file>.md#<anchor>`; without `#anchor`, the whole script.",
                          "type": "string",
                          "minLength": 1
                        },
                        "transform": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "description": "Horizontal offset in project pixels from the centered position. Default 0.",
                              "type": "number"
                            },
                            "y": {
                              "description": "Vertical offset in project pixels from the centered position. Default 0.",
                              "type": "number"
                            },
                            "scale": {
                              "description": "Uniform scale factor. Default 1.",
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "opacity": {
                              "description": "0 (invisible) to 1 (opaque). Default 1.",
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "additionalProperties": false,
                          "description": "Overlay placement (video tracks only)."
                        },
                        "audio": {
                          "type": "object",
                          "properties": {
                            "gain": {
                              "description": "Gain in dB; 0 = unchanged, negative = quieter. Default 0.",
                              "type": "number"
                            },
                            "muted": {
                              "description": "Default false.",
                              "type": "boolean"
                            }
                          },
                          "additionalProperties": false
                        },
                        "type": {
                          "type": "string",
                          "const": "media"
                        },
                        "asset": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Project-relative, `/`-separated, e.g. `assets/raw-01.mp4`."
                        },
                        "in": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Source seconds of the first frame."
                        },
                        "out": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "description": "Source seconds just after the last frame; greater than `in`."
                        },
                        "speed": {
                          "description": "Playback rate; 1 = normal, 2 = twice as fast. Default 1.",
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": [
                        "id",
                        "start",
                        "type",
                        "asset",
                        "in",
                        "out"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Stable, core-generated (`c_…`); reference clips by it."
                        },
                        "start": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Timeline seconds of the first frame."
                        },
                        "scriptRef": {
                          "description": "Script scene this clip realizes: `scripts/<file>.md#<anchor>`; without `#anchor`, the whole script.",
                          "type": "string",
                          "minLength": 1
                        },
                        "transform": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "description": "Horizontal offset in project pixels from the centered position. Default 0.",
                              "type": "number"
                            },
                            "y": {
                              "description": "Vertical offset in project pixels from the centered position. Default 0.",
                              "type": "number"
                            },
                            "scale": {
                              "description": "Uniform scale factor. Default 1.",
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "opacity": {
                              "description": "0 (invisible) to 1 (opaque). Default 1.",
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "additionalProperties": false,
                          "description": "Overlay placement (video tracks only)."
                        },
                        "audio": {
                          "type": "object",
                          "properties": {
                            "gain": {
                              "description": "Gain in dB; 0 = unchanged, negative = quieter. Default 0.",
                              "type": "number"
                            },
                            "muted": {
                              "description": "Default false.",
                              "type": "boolean"
                            }
                          },
                          "additionalProperties": false
                        },
                        "type": {
                          "type": "string",
                          "const": "timeline"
                        },
                        "source": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Project-relative timeline file, e.g. `timelines/intro.json`."
                        },
                        "in": {
                          "description": "Nested-timeline seconds of the first frame. Default 0.",
                          "type": "number",
                          "minimum": 0
                        },
                        "duration": {
                          "description": "Seconds played. Default: the rest of the nested timeline after `in`.",
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": [
                        "id",
                        "start",
                        "type",
                        "source"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Stable, core-generated (`c_…`); reference clips by it."
                        },
                        "start": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Timeline seconds of the first frame."
                        },
                        "scriptRef": {
                          "description": "Script scene this clip realizes: `scripts/<file>.md#<anchor>`; without `#anchor`, the whole script.",
                          "type": "string",
                          "minLength": 1
                        },
                        "transform": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "description": "Horizontal offset in project pixels from the centered position. Default 0.",
                              "type": "number"
                            },
                            "y": {
                              "description": "Vertical offset in project pixels from the centered position. Default 0.",
                              "type": "number"
                            },
                            "scale": {
                              "description": "Uniform scale factor. Default 1.",
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "opacity": {
                              "description": "0 (invisible) to 1 (opaque). Default 1.",
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "additionalProperties": false,
                          "description": "Overlay placement (video tracks only)."
                        },
                        "audio": {
                          "type": "object",
                          "properties": {
                            "gain": {
                              "description": "Gain in dB; 0 = unchanged, negative = quieter. Default 0.",
                              "type": "number"
                            },
                            "muted": {
                              "description": "Default false.",
                              "type": "boolean"
                            }
                          },
                          "additionalProperties": false
                        },
                        "type": {
                          "type": "string",
                          "pattern": "^(?!(?:media|timeline|shot)$)[a-z][a-z0-9-]*$",
                          "description": "Clip type registered by an adapter plugin, e.g. `hyperframes`."
                        },
                        "source": {
                          "description": "Project-relative composition entry, e.g. `compositions/hyperframes/intro/index.html`.",
                          "type": "string",
                          "minLength": 1
                        },
                        "in": {
                          "description": "Composition seconds of the first frame. Default 0.",
                          "type": "number",
                          "minimum": 0
                        },
                        "duration": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "description": "Seconds on the timeline."
                        },
                        "props": {
                          "description": "Adapter-specific properties, validated by the adapter.",
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        }
                      },
                      "required": [
                        "id",
                        "start",
                        "type",
                        "duration"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "description": "Sorted by `start`, never overlapping."
              }
            },
            "required": [
              "id",
              "kind",
              "clips"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable, core-generated (`t_…`)."
              },
              "kind": {
                "type": "string",
                "const": "program"
              },
              "name": {
                "type": "string"
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "description": "Id of the multicam group in the timeline's `groups`; one program track per group."
              },
              "clips": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Stable, core-generated (`c_…`); reference clips by it."
                    },
                    "type": {
                      "type": "string",
                      "const": "shot"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Timeline seconds of the first frame."
                    },
                    "in": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Group-clock seconds of the first frame."
                    },
                    "out": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "description": "Group-clock seconds just after the last frame; greater than `in`."
                    },
                    "shot": {
                      "type": "string",
                      "enum": [
                        "solo",
                        "two-up",
                        "grid"
                      ],
                      "description": "Layout: `solo` (one angle), `two-up` (two), `grid` (two or more)."
                    },
                    "angles": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": "Angle ids of the track's group, in layout order (left to right, then top to bottom); no repeats."
                    },
                    "confidence": {
                      "description": "Set by the director: 0 (a guess) to 1 (sure). Absent on shots a person chose.",
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "reason": {
                      "description": "Set by the director: why it chose this shot, in a few words.",
                      "type": "string",
                      "minLength": 1
                    },
                    "scriptRef": {
                      "description": "Script scene this clip realizes: `scripts/<file>.md#<anchor>`; without `#anchor`, the whole script.",
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "start",
                    "in",
                    "out",
                    "shot",
                    "angles"
                  ],
                  "additionalProperties": false
                },
                "description": "Shots, sorted by `start`, never overlapping."
              }
            },
            "required": [
              "id",
              "kind",
              "group",
              "clips"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "subtitles"
              },
              "name": {
                "type": "string"
              },
              "follows": {
                "type": "string",
                "minLength": 1,
                "description": "Id of the video or audio track whose clips supply the words."
              },
              "style": {
                "type": "object",
                "properties": {
                  "preset": {
                    "type": "string"
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "top",
                      "center",
                      "bottom"
                    ]
                  }
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "id",
              "kind",
              "follows"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "Stacking order: the first video track is the bottom layer."
    },
    "groups": {
      "description": "Multicam groups (ADR 0016), each shown by one program track.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable, core-generated (`g_…`); a program track names it in `group`."
          },
          "name": {
            "type": "string"
          },
          "angles": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Unique within the group; shots name angles by it."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Person or camera, e.g. `Ana`."
                },
                "asset": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Project-relative media file, e.g. `assets/ana.mp4`."
                },
                "offset": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Group-clock seconds at which the asset's time 0 plays: source time = group time - offset."
                },
                "crop": {
                  "type": "object",
                  "properties": {
                    "left": {
                      "description": "Default 0.",
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMaximum": 1
                    },
                    "top": {
                      "description": "Default 0.",
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMaximum": 1
                    },
                    "right": {
                      "description": "Default 0.",
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMaximum": 1
                    },
                    "bottom": {
                      "description": "Default 0.",
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMaximum": 1
                    }
                  },
                  "additionalProperties": false,
                  "description": "Fractions of the source picture (0 to below 1) cut off each side before a shot fills its tile with it."
                },
                "audio": {
                  "description": "Gain and mute of this angle's sound, which plays under every shot.",
                  "type": "object",
                  "properties": {
                    "gain": {
                      "description": "Gain in dB; 0 = unchanged, negative = quieter. Default 0.",
                      "type": "number"
                    },
                    "muted": {
                      "description": "Default false.",
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "name",
                "asset",
                "offset"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "angles"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "tracks"
  ],
  "additionalProperties": false,
  "$id": "https://frameshell.dev/schema/v1/timeline.json"
}
