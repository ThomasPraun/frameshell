{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "video",
        "image"
      ],
      "description": "What the project makes. `video` (default when absent): a timeline exported as a video. `image`: one still picture, the timeline's first frame, exported with `frame`; video tracks are its layers, first track at the bottom."
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "resolution": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "formats": {
      "description": "Delivery formats of one edit (ADR 0027), primary first. The first must equal `resolution`; ids are unique; built-in ids keep their canvas; later sizes are even; not allowed in image projects. Absent: one format, the resolution. Hosts older than ADR 0027 refuse a project that has this field.",
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
            "description": "Format id, e.g. `9x16` or `web-1600x900`: lowercase letters, digits and `-`, up to 40; not png, jpg, jpeg or webp."
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "width",
          "height"
        ],
        "additionalProperties": false,
        "description": "One delivery format: `id` and frame size in pixels. Built-in ids carry their own canvas: `16x9` 1920x1080, `1x1` 1080x1080, `4x5` 1080x1350, `9x16` 1080x1920. Sizes of formats after the first are even."
      }
    },
    "sampleRate": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "main": {
      "type": "string",
      "minLength": 1
    },
    "plugins": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "transcription": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    },
    "binaries": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "export": {
      "type": "object",
      "properties": {
        "defaultPreset": {
          "type": "string"
        },
        "loudness": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "editing": {
      "type": "object",
      "properties": {
        "snapWindow": {
          "description": "Default search half-width for moving cut and trim edges into audio pauses, seconds, 0.5 to 10. Default 0.5. A `snapWindow` passed to an operation (CLI `--snap-window`) overrides it.",
          "type": "number",
          "minimum": 0.5,
          "maximum": 10
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "fps",
    "resolution",
    "sampleRate",
    "main"
  ],
  "additionalProperties": false,
  "$id": "https://frameshell.dev/schema/v1/project.json"
}
