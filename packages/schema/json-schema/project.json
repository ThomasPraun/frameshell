{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "resolution": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "sampleRate": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "main": {
      "type": "string",
      "minLength": 1
    },
    "plugins": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "transcription": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    },
    "binaries": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "export": {
      "type": "object",
      "properties": {
        "defaultPreset": {
          "type": "string"
        },
        "loudness": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "editing": {
      "type": "object",
      "properties": {
        "snapWindow": {
          "description": "Default search half-width for moving cut and trim edges into audio pauses, seconds, 0.5 to 10. Default 0.5. A `snapWindow` passed to an operation (CLI `--snap-window`) overrides it.",
          "type": "number",
          "minimum": 0.5,
          "maximum": 10
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "fps",
    "resolution",
    "sampleRate",
    "main"
  ],
  "additionalProperties": false,
  "$id": "https://frameshell.dev/schema/v1/project.json"
}
