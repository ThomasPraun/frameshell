{
  "name": "@frameshell/schema",
  "version": "0.0.0",
  "description": "Zod models for Frameshell project files and their generated JSON Schema.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./composite": {
      "types": "./dist/composite.d.ts",
      "default": "./dist/composite.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "default": "./dist/motion.js"
    },
    "./subtitles": {
      "types": "./dist/subtitles.d.ts",
      "default": "./dist/subtitles.js"
    },
    "./transitions": {
      "types": "./dist/transitions.d.ts",
      "default": "./dist/transitions.js"
    },
    "./effects": {
      "types": "./dist/effects.d.ts",
      "default": "./dist/effects.js"
    },
    "./grade": {
      "types": "./dist/grade.d.ts",
      "default": "./dist/grade.js"
    },
    "./formats": {
      "types": "./dist/formats.d.ts",
      "default": "./dist/formats.js"
    },
    "./finish": {
      "types": "./dist/finish.d.ts",
      "default": "./dist/finish.js"
    },
    "./json-schema/*": "./json-schema/*"
  },
  "files": [
    "dist",
    "json-schema"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
