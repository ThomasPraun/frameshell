{
  "name": "@frameshell/core",
  "version": "0.0.0",
  "description": "frameshelld: the per-user Frameshell daemon, sole writer of project files.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./frameshelld": "./dist/bin/frameshelld.js",
    "./binaries": {
      "types": "./dist/binaries/manager.d.ts",
      "default": "./dist/binaries/manager.js"
    },
    "./fs-util": {
      "types": "./dist/fs-util.d.ts",
      "default": "./dist/fs-util.js"
    }
  },
  "bin": {
    "frameshelld": "./dist/bin/frameshelld.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@expo-google-fonts/archivo-black": "0.4.1",
    "@frameshell/plugin-api": "workspace:*",
    "@frameshell/protocol": "workspace:*",
    "@frameshell/schema": "workspace:*",
    "chokidar": "^5.0.0",
    "zod": "^4.6.5"
  }
}
